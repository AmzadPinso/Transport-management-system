@model montaherul.Models.TeacherModel

@{
    ViewData["Title"] = "Create Teacher";
}

@section Styles {
    <link rel="stylesheet" href="~/css/teacher.css" />
}

<div class="teacher-container">

    <h2 class="teacher-title">Add New Teacher</h2>

    <form asp-action="Create" enctype="multipart/form-data"  class="teacher-form">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label text-light"></label>
            <input asp-for="Name" class="form-control" placeholder="Enter teacher name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Subject" class="form-label text-light"></label>
            <input asp-for="Subject" class="form-control" placeholder="Enter subject" />
            <span asp-validation-for="Subject" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Age" class="form-label text-light"></label>
            <input asp-for="Age" class="form-control" placeholder="Enter age" />
            <span asp-validation-for="Age" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label text-light"></label>
            <input asp-for="Email" class="form-control" placeholder="Enter email address" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label text-light"></label>
            <input asp-for="Phone" class="form-control" placeholder="Enter phone number" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label text-light"></label>
            <input asp-for="Address" class="form-control" placeholder="Enter address" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label text-light">Profile Picture</label>
            <input type="file" name="imageFile" class="form-control" />
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-light">
                ← Back
            </a>

            <button type="submit" class="btn btn-teacher btn-details-teacher px-4">
                Create Teacher
            </button>
        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}