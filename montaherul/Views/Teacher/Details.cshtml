@model montaherul.Models.TeacherModel

@{
    ViewData["Title"] = "Teacher Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/teacher.css" />
}

<div class="teacher-container">

    <div class="text-center mb-4">

        @if (!string.IsNullOrEmpty(Model.ProfileImage))
        {
            <img src="~/images/teachers/@Model.ProfileImage"
                 class="rounded-circle shadow-lg mb-3"
                 style="width:120px; height:120px; object-fit:cover; border:4px solid #a29bfe;" />
        }
        else
        {
            <div class="rounded-circle bg-light text-dark d-inline-flex
                align-items-center justify-content-center shadow"
                 style="width:120px; height:120px; font-size:40px; font-weight:bold;">
                @Model.Name.Substring(0, 1)
            </div>
        }

        <h3 class="mt-3 text-light">@Model.Name</h3>
        <span class="badge bg-info fs-6">@Model.Subject</span>

    </div>

    <div class="row mt-4">

        <div class="col-md-6 mb-3">
            <div class="p-3 rounded bg-dark bg-opacity-50">
                <strong>Age:</strong>
                <div>@Model.Age</div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="p-3 rounded bg-dark bg-opacity-50">
                <strong>Email:</strong>
                <div>@Model.Email</div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="p-3 rounded bg-dark bg-opacity-50">
                <strong>Phone:</strong>
                <div>@Model.Phone</div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="p-3 rounded bg-dark bg-opacity-50">
                <strong>Address:</strong>
                <div>@Model.Address</div>
            </div>
        </div>

    </div>

    <div class="d-flex justify-content-between mt-4">
        <a asp-action="Index" class="btn btn-light">
            ← Back
        </a>

        <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-teacher btn-edit-teacher px-4">
            Edit Teacher
        </a>
    </div>

</div>