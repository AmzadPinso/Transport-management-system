@model IEnumerable<montaherul.Models.TeacherModel>

@{
    ViewData["Title"] = "Teacher List";
}

@section Styles {
    <link rel="stylesheet" href="~/css/teacher.css" />
}

<div class="teacher-container">

    <h2 class="teacher-title">Teacher Management</h2>

    <a asp-action="Create" class="btn btn-light mb-3">
        + Add New Teacher
    </a>

    <table class="table teacher-table align-middle">
        <thead>
            <tr>
                <th>Profile</th>
                <th>Name</th>

                @* <th>Subject</th> *@
                <th>Age</th>
                <th>Email</th>
                <th style="width:200px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>

                        <!-- PROFILE IMAGE -->
                        <td>
                            @if (!string.IsNullOrEmpty(item.ProfileImage))
                            {
                                <img src="~/images/teachers/@item.ProfileImage"
                                     class="rounded-circle"
                                     style="width:50px; height:50px; object-fit:cover; border:2px solid #a29bfe;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light text-dark d-flex
                                    align-items-center justify-content-center"
                                     style="width:50px; height:50px; font-weight:bold;">
                                    @item.Name.Substring(0, 1)
                                </div>
                            }
                        </td>

                        <td class="fw-bold">@item.Name</td>

                        @* <td>
                            <span class="badge bg-info">@item.Subject</span>
                        </td> *@
                        <td>@item.Age</td>
                        <td>@item.Email</td>

                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-teacher btn-edit-teacher btn-sm">
                                Edit
                            </a>

                            <a asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-teacher btn-details-teacher btn-sm">
                                Details
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-teacher btn-delete-teacher btn-sm">
                                Delete
                            </a>
                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-light">
                        No teachers found.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>