@model montaherul.Models.TeacherModel

@{
    ViewData["Title"] = "Edit Teacher";
}

@section Styles {
    <link rel="stylesheet" href="~/css/teacher.css" />
}

<div class="teacher-container">

    <h2 class="teacher-title">Edit Teacher</h2>

    <form asp-action="Edit" enctype="multipart/form-data" class="teacher-form">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input type="hidden" asp-for="Id" />

        <!-- 🔥 CURRENT PROFILE IMAGE PREVIEW -->
        <div class="text-center mb-4">

            @if (!string.IsNullOrEmpty(Model.ProfileImage))
            {
                <img src="~/images/teachers/@Model.ProfileImage"
                     class="rounded-circle shadow-lg"
                     style="width:120px; height:120px; object-fit:cover; border:4px solid #a29bfe;" />

                <p class="text-light mt-2">Current Profile Picture</p>
            }
            else
            {
                <div class="rounded-circle bg-light text-dark d-inline-flex
                    align-items-center justify-content-center shadow"
                     style="width:120px; height:120px; font-size:40px; font-weight:bold;">
                    @Model.Name.Substring(0, 1)
                </div>

                <p class="text-light mt-2">No profile picture uploaded</p>
            }

        </div>

        <!-- 🔥 CHANGE PROFILE PICTURE -->
        <div class="mb-3">
            <label class="form-label text-light">Update Profile Picture</label>
            <input type="file" name="imageFile" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label text-light"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Subject" class="form-label text-light"></label>
            <input asp-for="Subject" class="form-control" />
            <span asp-validation-for="Subject" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Age" class="form-label text-light"></label>
            <input asp-for="Age" class="form-control" />
            <span asp-validation-for="Age" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label text-light"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label text-light"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label text-light"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-light">
                ← Back
            </a>

            <button type="submit" class="btn btn-teacher btn-edit-teacher px-4">
                Update Teacher
            </button>
        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}