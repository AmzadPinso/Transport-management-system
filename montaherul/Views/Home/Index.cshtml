@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<!-- HERO SECTION -->
<section class="hero-section text-center text-white d-flex align-items-center">
    <div class="container">
        <h1 class="display-3 fw-bold">School Management System</h1>
        <p class="lead mt-3">
            Manage Teachers & Students Efficiently with a Modern Digital Platform
        </p>

        <div class="mt-4">
            <a asp-controller="Teacher" asp-action="Index" class="btn btn-light btn-lg me-3">
                Manage Teachers
            </a>

            <a asp-controller="Student" asp-action="Index" class="btn btn-outline-light btn-lg">
                Manage Students
            </a>
            <a asp-controller="Course" asp-action="Index" class="btn btn-warning btn-lg me-3">
                Manage Courses
            </a>
        </div>
    </div>
</section>

<!-- FEATURES SECTION -->
<section class="features-section py-5">
    <div class="container text-center">
        <h2 class="fw-bold mb-5">Why Choose Our System?</h2>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="feature-card p-4 shadow">
                    <h4>Easy Management</h4>
                    <p>
                        Add, edit, update and manage teacher & student records easily.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card p-4 shadow">
                    <h4>Secure Database</h4>
                    <p>
                        All data is securely stored using modern ASP.NET Core technology.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card p-4 shadow">
                    <h4>Modern Interface</h4>
                    <p>
                        Clean and responsive design for better user experience.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- CTA SECTION -->
<section class="cta-section text-center text-white py-5">
    <div class="container">
        <h2 class="fw-bold">Ready to Get Started?</h2>
        <p class="mt-3">
            Start managing your institution in a smarter and faster way.
        </p>
        <a asp-controller="Teacher" asp-action="Create" class="btn btn-warning btn-lg mt-3">
            Add New Teacher
        </a>
    </div>
</section>