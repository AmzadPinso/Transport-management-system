@model IEnumerable<Transport_Management_System.Models.Vehicle>

@{
    ViewData["Title"] = "Vehicle Management";
    int pageNumber = ViewBag.PageNumber;
    int totalPages = ViewBag.TotalPages;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Vehicle Fleet</h1>
            <p class="text-muted small mb-0">Manage and monitor your transport vehicles.</p>
        </div>
        <a asp-action="Create" class="btn-modern btn-modern-primary shadow-sm">
            <i class="fa-solid fa-plus"></i> <span>Add New Vehicle</span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search and Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <div class="col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0 text-muted">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" name="search" value="@ViewBag.Search" 
                               class="form-control bg-light border-0 ps-0" 
                               placeholder="Search by name or number..." />
                    </div>
                </div>
                <div class="col-lg-3">
                    <select name="type" class="form-select bg-light border-0" asp-items="Html.GetEnumSelectList<VehicleType>()">
                        <option value="">All Vehicle Types</option>
                    </select>
                </div>
                <div class="col-lg-3">
                    <select name="status" class="form-select bg-light border-0" asp-items="Html.GetEnumSelectList<VehicleStatus>()">
                        <option value="">All Statuses</option>
                    </select>
                </div>
                <div class="col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1 rounded-3">
                        <i class="fa-solid fa-filter me-2"></i>Filter
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.Search) || ViewBag.SelectedType != null || ViewBag.SelectedStatus != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary px-3 rounded-3" title="Clear Filters">
                            <i class="fa-solid fa-xmark"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Vehicles Table Container -->
    <div class="table-container animate-fade-in-up">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th>Vehicle Details</th>
                    <th>Type</th>
                    <th>Capacity</th>
                    <th>Status</th>
                    <th>Last Service</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="user-avatar" style="width: 32px; height: 32px; font-size: 0.8rem; background-color: var(--bs-primary-bg-subtle); color: var(--bs-primary);">
                                        @if (item.VehicleType == VehicleType.Bus || item.VehicleType == VehicleType.MiniBus) { <i class="fa-solid fa-bus"></i> }
                                        else if (item.VehicleType == VehicleType.Truck) { <i class="fa-solid fa-truck"></i> }
                                        else { <i class="fa-solid fa-car"></i> }
                                    </div>
                                    <div>
                                        <div class="fw-bold">@item.VehicleName</div>
                                        <div class="small text-muted">@item.VehicleNumber</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="fw-medium text-dark">@item.VehicleType</span>
                            </td>
                            <td>
                                <span class="fw-bold">@item.Capacity</span> <small class="text-muted">Seats/Ton</small>
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case VehicleStatus.Active:
                                        <span class="badge rounded-pill bg-success-subtle text-success border-0 px-3 py-2">Active</span>
                                        break;
                                    case VehicleStatus.InMaintenance:
                                        <span class="badge rounded-pill bg-warning-subtle text-warning border-0 px-3 py-2">Maintenance</span>
                                        break;
                                    case VehicleStatus.OutOfService:
                                        <span class="badge rounded-pill bg-danger-subtle text-danger border-0 px-3 py-2">Offline</span>
                                        break;
                                }
                            </td>
                            <td class="text-muted small">
                                @item.LastServiceDate.ToString("MMM dd, yyyy")
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.VehicleId" class="btn btn-sm btn-outline-primary border-0 rounded-circle p-2" title="Edit Vehicle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.VehicleId" class="btn btn-sm btn-outline-info border-0 rounded-circle p-2" title="View Details">
                                        <i class="fa-solid fa-circle-info"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.VehicleId" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2" title="Delete Vehicle">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-truck-slash d-block fs-1 mb-3 opacity-25"></i>
                            <p class="mb-0">No vehicles found matching your criteria.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Modern Pagination -->
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination pagination-modern gap-2">
                    <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                        <a class="page-link border-0 rounded-circle shadow-sm" asp-action="Index" 
                           asp-route-pageNumber="@(pageNumber - 1)" 
                           asp-route-search="@ViewBag.Search" 
                           asp-route-type="@ViewBag.SelectedType" 
                           asp-route-status="@ViewBag.SelectedStatus">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item">
                            <a class="page-link border-0 shadow-sm rounded-circle @(i == pageNumber ? "bg-primary text-white" : "bg-white text-dark")" 
                               asp-action="Index" 
                               asp-route-pageNumber="@i" 
                               asp-route-search="@ViewBag.Search" 
                               asp-route-type="@ViewBag.SelectedType" 
                               asp-route-status="@ViewBag.SelectedStatus">@i</a>
                        </li>
                    }
                    <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                        <a class="page-link border-0 rounded-circle shadow-sm" asp-action="Index" 
                           asp-route-pageNumber="@(pageNumber + 1)" 
                           asp-route-search="@ViewBag.Search" 
                           asp-route-type="@ViewBag.SelectedType" 
                           asp-route-status="@ViewBag.SelectedStatus">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
