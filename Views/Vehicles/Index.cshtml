@model IEnumerable<Transport_Management_System.Models.Vehicle>

@{
    ViewData["Title"] = "Vehicle Management";
    int pageNumber = ViewBag.PageNumber;
    int totalPages = ViewBag.TotalPages;
}

<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold text-dark mb-0">
                <i class="fa-solid fa-truck-moving me-2 text-primary"></i>Vehicle Fleet
            </h2>
            <p class="text-muted mb-0">Manage and monitor your transport vehicles</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm">
                <i class="fa-solid fa-plus me-2"></i>Add New Vehicle
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search and Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0 ps-0" placeholder="Search by name or number...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="type" class="form-select bg-light border-0" asp-items="Html.GetEnumSelectList<VehicleType>()">
                        <option value="">All Vehicle Types</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select bg-light border-0" asp-items="Html.GetEnumSelectList<VehicleStatus>()">
                        <option value="">All Statuses</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-dark rounded-3">
                        <i class="fa-solid fa-filter me-2"></i>Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Vehicles Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase fs-xs fw-bold text-muted">Vehicle Details</th>
                        <th class="py-3 text-uppercase fs-xs fw-bold text-muted text-center">Type</th>
                        <th class="py-3 text-uppercase fs-xs fw-bold text-muted text-center">Capacity</th>
                        <th class="py-3 text-uppercase fs-xs fw-bold text-muted text-center">Status</th>
                        <th class="py-3 text-uppercase fs-xs fw-bold text-muted text-center">Last Service</th>
                        <th class="pe-4 py-3 text-uppercase fs-xs fw-bold text-muted text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm bg-primary-soft text-primary rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            @if (item.VehicleType == VehicleType.Bus || item.VehicleType == VehicleType.MiniBus) { <i class="fa-solid fa-bus"></i> }
                                            else if (item.VehicleType == VehicleType.Truck) { <i class="fa-solid fa-truck"></i> }
                                            else { <i class="fa-solid fa-car"></i> }
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark">@item.VehicleName</h6>
                                            <small class="text-muted">@item.VehicleNumber</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="text-dark fw-medium">@item.VehicleType</span>
                                </td>
                                <td class="text-center text-dark">
                                    <span class="fw-bold">@item.Capacity</span> <small class="text-muted">Seats/Ton</small>
                                </td>
                                <td class="text-center">
                                    @switch (item.Status)
                                    {
                                        case VehicleStatus.Active:
                                            <span class="badge bg-success-soft text-success px-3 py-2 rounded-pill">Active</span>
                                            break;
                                        case VehicleStatus.InMaintenance:
                                            <span class="badge bg-warning-soft text-warning px-3 py-2 rounded-pill">Maintenance</span>
                                            break;
                                        case VehicleStatus.OutOfService:
                                            <span class="badge bg-danger-soft text-danger px-3 py-2 rounded-pill">Offline</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center text-muted">
                                    @item.LastServiceDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.VehicleId" class="btn btn-sm btn-outline-secondary rounded-start-3" title="View Details">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.VehicleId" class="btn btn-sm btn-outline-primary" title="Edit Vehicle">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.VehicleId" class="btn btn-sm btn-outline-danger rounded-end-3" title="Delete Vehicle">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-5 text-center">
                                <div class="text-muted">
                                    <i class="fa-solid fa-truck-slash display-4 mb-3 d-block"></i>
                                    <h5 class="fw-bold">No Vehicles Found</h5>
                                    <p>Try adjusting your search or add a new vehicle to the fleet.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                    <a class="page-link shadow-sm rounded-start-3" asp-action="Index" asp-route-pageNumber="@(pageNumber - 1)" asp-route-search="@ViewBag.Search" asp-route-type="@ViewBag.SelectedType" asp-route-status="@ViewBag.SelectedStatus">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == pageNumber ? "active" : "")">
                        <a class="page-link shadow-sm" asp-action="Index" asp-route-pageNumber="@i" asp-route-search="@ViewBag.Search" asp-route-type="@ViewBag.SelectedType" asp-route-status="@ViewBag.SelectedStatus">@i</a>
                    </li>
                }
                <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                    <a class="page-link shadow-sm rounded-end-3" asp-action="Index" asp-route-pageNumber="@(pageNumber + 1)" asp-route-search="@ViewBag.Search" asp-route-type="@ViewBag.SelectedType" asp-route-status="@ViewBag.SelectedStatus">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

<style>
    .bg-primary-soft { background-color: rgba(13, 110, 253, 0.1); }
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .bg-warning-soft { background-color: rgba(255, 193, 7, 0.1); }
    .bg-danger-soft { background-color: rgba(220, 53, 69, 0.1); }
    .fs-xs { font-size: 0.75rem; }
    .avatar-sm { width: 40px; height: 40px; }
</style>
