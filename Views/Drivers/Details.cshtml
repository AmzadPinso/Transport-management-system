@model Transport_Management_System.Models.Driver
@using Transport_Management_System.Models

@{
    ViewData["Title"] = "Driver Profile";

    var daysUntilExpiry = (Model.LicenseExpiryDate - DateTime.Now).TotalDays;
    var licenseBadgeClass = daysUntilExpiry < 0 ? "bg-danger" : (daysUntilExpiry <= 30 ? "bg-warning text-dark" : "bg-success");
    var licenseStatusText = daysUntilExpiry < 0 ? "Expired" : (daysUntilExpiry <= 30 ? "Expiring Soon" : "Valid");

    var statusBadgeClass = Model.AvailabilityStatus switch
    {
        DriverAvailabilityStatus.Available => "bg-success-subtle text-success border-success",
        DriverAvailabilityStatus.OnTrip => "bg-primary-subtle text-primary border-primary",
        DriverAvailabilityStatus.OnLeave => "bg-warning-subtle text-warning border-warning",
        _ => "bg-secondary-subtle text-secondary border-secondary"
    };
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Driver Profile</h2>
            <p class="text-muted mb-0">Detailed information and assignment status</p>
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model?.DriverId" class="btn btn-dark px-4 py-2 rounded-3 shadow-sm fw-bold me-2">
                <i class="fa-solid fa-pen text-warning me-2"></i>Edit Profile
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-bold">
                <i class="fa-solid fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Profile Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="card-body p-0">
                    <div class="bg-primary py-5 text-center">
                        <div class="avatar-xl bg-white text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 shadow" style="width: 100px; height: 100px; font-size: 3rem; font-weight: bold;">
                            @Model.FullName.Substring(0, 1).ToUpper()
                        </div>
                        <h4 class="text-white fw-bold mb-0">@Model.FullName</h4>
                        <div class="mt-2">
                            <span class="badge border @statusBadgeClass rounded-pill bg-white px-3 py-2">
                                @Model.AvailabilityStatus
                            </span>
                        </div>
                    </div>
                    <div class="p-4">
                        <div class="list-group list-group-flush">
                            <div class="list-group-item bg-transparent border-0 d-flex align-items-center mb-3">
                                <i class="fa-solid fa-phone text-primary me-3 fs-5"></i>
                                <div>
                                    <small class="text-muted d-block">Phone Number</small>
                                    <span class="fw-medium">@Model.PhoneNumber</span>
                                </div>
                            </div>
                            <div class="list-group-item bg-transparent border-0 d-flex align-items-center mb-3">
                                <i class="fa-solid fa-envelope text-primary me-3 fs-5"></i>
                                <div>
                                    <small class="text-muted d-block">Email</small>
                                    <span class="fw-medium">@(string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email)</span>
                                </div>
                            </div>
                            <div class="list-group-item bg-transparent border-0 d-flex align-items-center mb-3">
                                <i class="fa-solid fa-location-dot text-primary me-3 fs-5"></i>
                                <div>
                                    <small class="text-muted d-block">Address</small>
                                    <span class="fw-medium">@(string.IsNullOrEmpty(Model.Address) ? "N/A" : Model.Address)</span>
                                </div>
                            </div>
                            <div class="list-group-item bg-transparent border-0 d-flex align-items-center">
                                <i class="fa-solid fa-briefcase text-primary me-3 fs-5"></i>
                                <div>
                                    <small class="text-muted d-block">Experience</small>
                                    <span class="fw-medium">@Model.ExperienceYears Years</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-8">
            <div class="row g-4">
                <!-- License Info Card -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4 p-md-5">
                            <h5 class="fw-bold mb-4 border-bottom pb-2">
                                <i class="fa-solid fa-id-badge text-primary me-2"></i>License Details
                            </h5>
                            
                            @if (daysUntilExpiry <= 30)
                            {
                                <div class="alert alert-warning border-0 border-start border-4 border-warning rounded-3 d-flex align-items-center mb-4">
                                    <i class="fa-solid fa-triangle-exclamation fs-3 text-warning me-3"></i>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">Attention Required</h6>
                                        <p class="mb-0 small text-dark">This driver's license is @licenseStatusText. Please ensure it is renewed to maintain compliance.</p>
                                    </div>
                                </div>
                            }

                            <div class="row g-4">
                                <div class="col-sm-6">
                                    <small class="text-muted fw-bold d-block mb-1">License Number</small>
                                    <p class="fs-5 fw-medium mb-0">@Model.LicenseNumber</p>
                                </div>
                                <div class="col-sm-6">
                                    <small class="text-muted fw-bold d-block mb-1">License Status</small>
                                    <span class="badge @licenseBadgeClass fs-6 rounded-pill px-3 py-2">
                                        @licenseStatusText (@Model.LicenseExpiryDate.ToString("MMM dd, yyyy"))
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Assignment & System Info -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4 p-md-5">
                            <h5 class="fw-bold mb-4 border-bottom pb-2">
                                <i class="fa-solid fa-truck-ramp-box text-primary me-2"></i>Assignment & System Info
                            </h5>
                            
                            <div class="row g-4">
                                <div class="col-sm-6">
                                    <div class="p-3 bg-light rounded-3 border">
                                        <small class="text-muted fw-bold d-block mb-2">Assigned Vehicle</small>
                                        @if (Model.AssignedVehicle != null)
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="fa-solid fa-truck fs-3 text-primary me-3"></i>
                                                <div>
                                                    <h6 class="fw-bold mb-0">@Model.AssignedVehicle.VehicleNumber</h6>
                                                    <small class="text-muted">@Model.AssignedVehicle.VehicleName</small>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center text-muted">
                                                <i class="fa-solid fa-truck fs-3 me-3 opacity-50"></i>
                                                <span class="fst-italic">No Vehicle Assigned</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                                
                                <div class="col-sm-6">
                                    <div class="d-flex flex-column justify-content-center h-100">
                                        <div class="mb-3">
                                            <small class="text-muted fw-bold d-block mb-1">Joining Date</small>
                                            <p class="fw-medium mb-0"><i class="fa-solid fa-calendar-check text-success me-2"></i>@Model.JoiningDate.ToString("MMM dd, yyyy")</p>
                                        </div>
                                        <div>
                                            <small class="text-muted fw-bold d-block mb-1">Last Profile Update</small>
                                            <p class="fw-medium mb-0 small"><i class="fa-solid fa-clock text-secondary me-2"></i>@Model.UpdatedAt.ToString("g")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
