@model IEnumerable<Transport_Management_System.Models.MaintenanceRecord>
@{
    ViewData["Title"] = "Maintenance Reports & Fleet Health";
}

<div class="page-header animate-fade-in d-print-none">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="page-title">Maintenance Reports & Fleet Health</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-custom mb-0">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-primary">TMS PRO</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Reports" asp-action="Index" class="text-decoration-none text-primary">Reports Center</a></li>
                    <li class="breadcrumb-item active">Maintenance</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <button onclick="window.print()" class="btn btn-outline-secondary btn-modern shadow-sm">
                <i class="fa-solid fa-print me-2"></i>Print Report
            </button>
        </div>
    </div>
</div>

<!-- Print-Only Header -->
<div class="d-none d-print-block mb-4 text-center">
    <h2 class="fw-bold">Smart Transport Management System (STMS)</h2>
    <h4>Fleet Maintenance & Service Audits Report</h4>
    <p class="text-muted">Generated on @DateTime.Now.ToString("F") | Period: @(ViewBag.StartDate ?? "Inception") to @(ViewBag.EndDate ?? "Present")</p>
    <hr />
</div>

<!-- Filter Section -->
<div class="card-modern mb-4 animate-fade-in delay-1 d-print-none">
    <div class="card-body-modern p-4">
        <form method="get" asp-controller="Reports" asp-action="Maintenance" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">Start Date</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control form-control-modern" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">End Date</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control form-control-modern" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">Maintenance Status</label>
                <select name="status" class="form-select form-select-modern">
                    <option value="">All Statuses</option>
                    @foreach (var val in Enum.GetValues(typeof(Transport_Management_System.Models.MaintenanceStatus)))
                    {
                        if (ViewBag.Status != null && (Transport_Management_System.Models.MaintenanceStatus)ViewBag.Status == (Transport_Management_System.Models.MaintenanceStatus)val)
                        {
                            <option value="@val" selected>@val</option>
                        }
                        else
                        {
                            <option value="@val">@val</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-modern w-100">
                    <i class="fa-solid fa-filter me-2"></i>Filter
                </button>
                <a asp-controller="Reports" asp-action="Maintenance" class="btn btn-light btn-modern border w-100">
                    <i class="fa-solid fa-rotate-left me-2"></i>Reset
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Summary Stats Row -->
<div class="row animate-fade-in delay-1 mb-4">
    <div class="col-6 col-lg-3 mb-3">
        <div class="card-modern border-start border-primary border-4 p-3 shadow-sm h-100">
            <p class="text-muted small mb-1 fw-bold">Report Total Services</p>
            <h4 class="fw-bold mb-0 text-primary">@Model.Count()</h4>
        </div>
    </div>
    <div class="col-6 col-lg-3 mb-3">
        <div class="card-modern border-start border-success border-4 p-3 shadow-sm h-100">
            <p class="text-muted small mb-1 fw-bold">Completed Services</p>
            <h4 class="fw-bold mb-0 text-success">@Model.Count(r => r.Status == Transport_Management_System.Models.MaintenanceStatus.Completed)</h4>
        </div>
    </div>
    <div class="col-6 col-lg-3 mb-3">
        <div class="card-modern border-start border-warning border-4 p-3 shadow-sm h-100">
            <p class="text-muted small mb-1 fw-bold">In-Progress / Scheduled</p>
            <h4 class="fw-bold mb-0 text-warning">@Model.Count(r => r.Status == Transport_Management_System.Models.MaintenanceStatus.InProgress || r.Status == Transport_Management_System.Models.MaintenanceStatus.Scheduled)</h4>
        </div>
    </div>
    <div class="col-6 col-lg-3 mb-3">
        <div class="card-modern border-start border-danger border-4 p-3 shadow-sm h-100">
            <p class="text-muted small mb-1 fw-bold">Total Service Cost</p>
            <h4 class="fw-bold mb-0 text-danger">৳@ViewBag.TotalCost.ToString("N2")</h4>
        </div>
    </div>
</div>

<!-- Report Table -->
<div class="card-modern shadow-sm animate-fade-in delay-2 mb-4">
    <div class="card-header-modern border-bottom-0 pb-0">
        <h5 class="card-title-modern fw-bold"><i class="fa-solid fa-screwdriver-wrench text-primary me-2"></i>Service Log History</h5>
    </div>
    <div class="card-body-modern p-0">
        <div class="table-responsive">
            <table class="table table-modern align-middle mb-0">
                <thead>
                    <tr>
                        <th>Vehicle Name</th>
                        <th>Plate Number</th>
                        <th>Type</th>
                        <th>Provider</th>
                        <th>Service Date</th>
                        <th>Next Due Date</th>
                        <th>Notes</th>
                        <th class="text-end">Cost</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var record in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@record.Vehicle?.VehicleName</td>
                                <td>@record.Vehicle?.VehicleNumber</td>
                                <td><span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">@record.MaintenanceType</span></td>
                                <td>@record.ServiceProvider</td>
                                <td>@record.ServiceDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @{
                                        var isOverdue = record.Status != Transport_Management_System.Models.MaintenanceStatus.Completed && record.NextServiceDate < DateTime.Today;
                                    }
                                    <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                        @record.NextServiceDate.ToString("yyyy-MM-dd")
                                        @if (isOverdue)
                                        {
                                            <i class="fa-solid fa-triangle-exclamation ms-1" title="Service Overdue!"></i>
                                        }
                                    </span>
                                </td>
                                <td class="text-wrap" style="max-width: 200px;">@record.Notes</td>
                                <td class="text-end fw-semibold text-danger">৳@record.Cost.ToString("N2")</td>
                                <td>
                                    <span class="badge @(record.Status == Transport_Management_System.Models.MaintenanceStatus.Completed ? "bg-success" : record.Status == Transport_Management_System.Models.MaintenanceStatus.InProgress ? "bg-warning" : "bg-info") bg-opacity-10 text-@(record.Status == Transport_Management_System.Models.MaintenanceStatus.Completed ? "success" : record.Status == Transport_Management_System.Models.MaintenanceStatus.InProgress ? "warning" : "info") border border-@(record.Status == Transport_Management_System.Models.MaintenanceStatus.Completed ? "success" : record.Status == Transport_Management_System.Models.MaintenanceStatus.InProgress ? "warning" : "info") border-opacity-25 px-2 py-1">
                                        @record.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No maintenance audit records found matching selected filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
