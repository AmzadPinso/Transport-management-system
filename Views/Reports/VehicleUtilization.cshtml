@model Transport_Management_System.Services.VehicleUtilizationViewModel
@{
    ViewData["Title"] = "Vehicle Utilization & Fleet Analytics";
}

<div class="page-header animate-fade-in d-print-none">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="page-title">Vehicle Utilization & Fleet Analytics</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-custom mb-0">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-primary">TMS PRO</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Reports" asp-action="Index" class="text-decoration-none text-primary">Reports Center</a></li>
                    <li class="breadcrumb-item active">Vehicle Utilization</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <button onclick="window.print()" class="btn btn-outline-secondary btn-modern shadow-sm me-2">
                <i class="fa-solid fa-print me-2"></i>Print Report
            </button>
        </div>
    </div>
</div>

<!-- Print-Only Header -->
<div class="d-none d-print-block mb-4 text-center">
    <h2 class="fw-bold">Smart Transport Management System (STMS)</h2>
    <h4>Vehicle Utilization & Fleet Analytics Report</h4>
    <p class="text-muted">Generated on @DateTime.Now.ToString("F")</p>
    <hr />
</div>

<!-- Fleet Analytics KPI Cards -->
<div class="row animate-fade-in delay-1 mb-4">
    <!-- Total Vehicles -->
    <div class="col-md-3 mb-3">
        <div class="stat-card bg-card shadow-sm h-100">
            <div class="stat-card-content">
                <p class="text-muted small mb-1">Total Fleet Vehicles</p>
                <h3 class="fw-bold text-primary mb-0">@Model.TotalVehicles</h3>
                <span class="text-muted small">Registered transport fleet</span>
            </div>
            <div class="stat-icon bg-primary-subtle text-primary">
                <i class="fa-solid fa-truck"></i>
            </div>
        </div>
    </div>

    <!-- Availability Rate -->
    <div class="col-md-3 mb-3">
        <div class="stat-card bg-card shadow-sm h-100">
            <div class="stat-card-content">
                <p class="text-muted small mb-1">Vehicle Availability Rate</p>
                <h3 class="fw-bold text-success mb-0">@Model.AvailabilityRate%</h3>
                <div class="progress mt-2" style="height: 6px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @Model.AvailabilityRate%"></div>
                </div>
            </div>
            <div class="stat-icon bg-success-subtle text-success">
                <i class="fa-solid fa-square-check"></i>
            </div>
        </div>
    </div>

    <!-- Top Performing Vehicle -->
    <div class="col-md-3 mb-3">
        <div class="stat-card bg-card shadow-sm h-100">
            <div class="stat-card-content">
                <p class="text-muted small mb-1">Most Utilized Vehicle</p>
                @if (Model.TopVehicles.Any())
                {
                    <h5 class="fw-bold text-info mb-0">@Model.TopVehicles.First().VehicleName</h5>
                    <span class="text-muted small">@Model.TopVehicles.First().TotalTrips Trips Dispatched</span>
                }
                else
                {
                    <h5 class="fw-bold text-muted mb-0">None</h5>
                }
            </div>
            <div class="stat-icon bg-info-subtle text-info">
                <i class="fa-solid fa-circle-up"></i>
            </div>
        </div>
    </div>

    <!-- Most Maintained Vehicle -->
    <div class="col-md-3 mb-3">
        <div class="stat-card bg-card shadow-sm h-100">
            <div class="stat-card-content">
                <p class="text-muted small mb-1">Highest Maintenance Cost</p>
                @if (Model.MaintenanceFrequency.Any(x => x.TotalMaintenanceCost > 0))
                {
                    var topM = Model.MaintenanceFrequency.OrderByDescending(x => x.TotalMaintenanceCost).First();
                    <h5 class="fw-bold text-danger mb-0">@topM.VehicleName</h5>
                    <span class="text-muted small">Cost: ৳@topM.TotalMaintenanceCost.ToString("N0")</span>
                }
                else
                {
                    <h5 class="fw-bold text-muted mb-0">None</h5>
                }
            </div>
            <div class="stat-icon bg-danger-subtle text-danger">
                <i class="fa-solid fa-wrench"></i>
            </div>
        </div>
    </div>
</div>

<!-- Fleet Usage Charts -->
<div class="row animate-fade-in delay-2 mb-4">
    <!-- Vehicle Usage Bar Chart -->
    <div class="col-lg-6 mb-4">
        <div class="card-modern shadow-sm h-100">
            <div class="card-header-modern">
                <h5 class="card-title-modern fw-bold"><i class="fa-solid fa-chart-bar text-primary me-2"></i>Trip Frequency per Vehicle</h5>
            </div>
            <div class="card-body-modern">
                <div id="usage-chart" style="min-height: 350px;"></div>
            </div>
        </div>
    </div>

    <!-- Maintenance Frequency Chart -->
    <div class="col-lg-6 mb-4">
        <div class="card-modern shadow-sm h-100">
            <div class="card-header-modern">
                <h5 class="card-title-modern fw-bold"><i class="fa-solid fa-screwdriver-wrench text-primary me-2"></i>Maintenance Frequency (Checkups)</h5>
            </div>
            <div class="card-body-modern">
                <div id="maintenance-freq-chart" style="min-height: 350px;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Tables Section: Performance and Underutilization -->
<div class="row animate-fade-in delay-3 mb-4">
    <!-- Top Performing Vehicles -->
    <div class="col-md-6 mb-4">
        <div class="card-modern shadow-sm h-100">
            <div class="card-header-modern">
                <h5 class="card-title-modern fw-bold text-success"><i class="fa-solid fa-circle-arrow-up me-2"></i>Top Performing Vehicles (Most Active)</h5>
            </div>
            <div class="card-body-modern p-0">
                <div class="table-responsive">
                    <table class="table table-modern align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Vehicle Name</th>
                                <th>Plate Number</th>
                                <th class="text-center">Total Trips</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopVehicles.Any(x => x.TotalTrips > 0))
                            {
                                foreach (var vehicle in Model.TopVehicles.Where(x => x.TotalTrips > 0))
                                {
                                    <tr>
                                        <td class="fw-bold">@vehicle.VehicleName</td>
                                        <td>@vehicle.VehicleNumber</td>
                                        <td class="text-center fw-bold text-primary">@vehicle.TotalTrips</td>
                                        <td>
                                            <span class="badge @(vehicle.Status == "Active" ? "bg-success" : vehicle.Status == "InMaintenance" ? "bg-warning" : "bg-danger") bg-opacity-10 text-@(vehicle.Status == "Active" ? "success" : vehicle.Status == "InMaintenance" ? "warning" : "danger") border border-@(vehicle.Status == "Active" ? "success" : vehicle.Status == "InMaintenance" ? "warning" : "danger") border-opacity-25 px-2 py-1">
                                                @vehicle.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No trip data available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Underutilized Vehicles -->
    <div class="col-md-6 mb-4">
        <div class="card-modern shadow-sm h-100">
            <div class="card-header-modern">
                <h5 class="card-title-modern fw-bold text-warning"><i class="fa-solid fa-circle-arrow-down me-2"></i>Underutilized Vehicles (Least Active)</h5>
            </div>
            <div class="card-body-modern p-0">
                <div class="table-responsive">
                    <table class="table table-modern align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Vehicle Name</th>
                                <th>Plate Number</th>
                                <th class="text-center">Total Trips</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.UnderutilizedVehicles.Any())
                            {
                                foreach (var vehicle in Model.UnderutilizedVehicles)
                                {
                                    <tr>
                                        <td class="fw-bold">@vehicle.VehicleName</td>
                                        <td>@vehicle.VehicleNumber</td>
                                        <td class="text-center fw-bold text-warning">@vehicle.TotalTrips</td>
                                        <td>
                                            <span class="badge @(vehicle.Status == "Active" ? "bg-success" : vehicle.Status == "InMaintenance" ? "bg-warning" : "bg-danger") bg-opacity-10 text-@(vehicle.Status == "Active" ? "success" : vehicle.Status == "InMaintenance" ? "warning" : "danger") border border-@(vehicle.Status == "Active" ? "success" : vehicle.Status == "InMaintenance" ? "warning" : "danger") border-opacity-25 px-2 py-1">
                                                @vehicle.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No underutilized vehicles found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Fleet Maintenance Checkup Summary -->
<div class="card-modern shadow-sm animate-fade-in delay-3 mb-4">
    <div class="card-header-modern">
        <h5 class="card-title-modern fw-bold"><i class="fa-solid fa-wrench text-primary me-2"></i>Fleet Maintenance and Service Costs Audit</h5>
    </div>
    <div class="card-body-modern p-0">
        <div class="table-responsive">
            <table class="table table-modern align-middle mb-0">
                <thead>
                    <tr>
                        <th>Vehicle Name</th>
                        <th>Plate Number</th>
                        <th class="text-center">Maintenance Service Count</th>
                        <th class="text-end">Accumulated Cost (BDT)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.MaintenanceFrequency.Any())
                    {
                        foreach (var item in Model.MaintenanceFrequency)
                        {
                            <tr>
                                <td class="fw-bold">@item.VehicleName</td>
                                <td>@item.VehicleNumber</td>
                                <td class="text-center fw-semibold">@item.MaintenanceCount</td>
                                <td class="text-end fw-semibold text-danger">৳@item.TotalMaintenanceCost.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No maintenance checkups audit logs found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Vehicle Usage Chart
            var usageNames = @Html.Raw(Json.Serialize(Model.TopVehicles.Select(v => v.VehicleName)));
            var usageTrips = @Html.Raw(Json.Serialize(Model.TopVehicles.Select(v => v.TotalTrips)));

            var usageOptions = {
                series: [{
                    name: 'Total Trips',
                    data: usageTrips
                }],
                chart: {
                    height: 350,
                    type: 'bar',
                    toolbar: { show: false },
                    fontFamily: 'Inter, sans-serif'
                },
                colors: ['#06b6d4'],
                plotOptions: {
                    bar: {
                        borderRadius: 6,
                        columnWidth: '45%'
                    }
                },
                dataLabels: { enabled: false },
                xaxis: {
                    categories: usageNames
                },
                grid: {
                    borderColor: 'rgba(0,0,0,0.05)',
                    strokeDashArray: 4
                }
            };

            var usageChart = new ApexCharts(document.querySelector("#usage-chart"), usageOptions);
            usageChart.render();

            // 2. Maintenance Frequency Chart
            var maintNames = @Html.Raw(Json.Serialize(Model.MaintenanceFrequency.Select(m => m.VehicleName)));
            var maintCounts = @Html.Raw(Json.Serialize(Model.MaintenanceFrequency.Select(m => m.MaintenanceCount)));
            var maintCosts = @Html.Raw(Json.Serialize(Model.MaintenanceFrequency.Select(m => m.TotalMaintenanceCost)));

            var maintOptions = {
                series: [{
                    name: 'Checkups (Count)',
                    type: 'column',
                    data: maintCounts
                }, {
                    name: 'Costs (BDT)',
                    type: 'line',
                    data: maintCosts
                }],
                chart: {
                    height: 350,
                    type: 'line',
                    toolbar: { show: false },
                    fontFamily: 'Inter, sans-serif'
                },
                colors: ['#f59e0b', '#ef4444'],
                stroke: { width: [0, 3], curve: 'smooth' },
                dataLabels: { enabled: false },
                xaxis: {
                    categories: maintNames
                },
                yaxis: [
                    {
                        title: { text: "Service Count" }
                    },
                    {
                        opposite: true,
                        title: { text: "Total Cost (BDT)" },
                        labels: {
                            formatter: function (val) {
                                return "৳" + val.toLocaleString();
                            }
                        }
                    }
                ],
                grid: {
                    borderColor: 'rgba(0,0,0,0.05)',
                    strokeDashArray: 4
                }
            };

            var maintChart = new ApexCharts(document.querySelector("#maintenance-freq-chart"), maintOptions);
            maintChart.render();
        });
    </script>
}
