@model IEnumerable<Transport_Management_System.Models.Expense>
@{
    ViewData["Title"] = "Expense Reports & Audits";
}

<div class="page-header animate-fade-in d-print-none">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="page-title">Expense Reports & Audits</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-custom mb-0">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-primary">TMS PRO</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Reports" asp-action="Index" class="text-decoration-none text-primary">Reports Center</a></li>
                    <li class="breadcrumb-item active">Expenses</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <button onclick="window.print()" class="btn btn-outline-secondary btn-modern shadow-sm">
                <i class="fa-solid fa-print me-2"></i>Print Report
            </button>
        </div>
    </div>
</div>

<!-- Print-Only Header -->
<div class="d-none d-print-block mb-4 text-center">
    <h2 class="fw-bold">Smart Transport Management System (STMS)</h2>
    <h4>Fleet Operations Expense Audit Report</h4>
    <p class="text-muted">Generated on @DateTime.Now.ToString("F") | Period: @(ViewBag.StartDate ?? "Inception") to @(ViewBag.EndDate ?? "Present")</p>
    <hr />
</div>

<!-- Filter Section -->
<div class="card-modern mb-4 animate-fade-in delay-1 d-print-none">
    <div class="card-body-modern p-4">
        <form method="get" asp-controller="Reports" asp-action="Expenses" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">Start Date</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control form-control-modern" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">End Date</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control form-control-modern" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">Expense Category</label>
                <select name="category" class="form-select form-select-modern">
                    <option value="">All Categories</option>
                    @foreach (var val in Enum.GetValues(typeof(Transport_Management_System.Models.ExpenseCategory)))
                    {
                        if (ViewBag.Category != null && (Transport_Management_System.Models.ExpenseCategory)ViewBag.Category == (Transport_Management_System.Models.ExpenseCategory)val)
                        {
                            <option value="@val" selected>@val</option>
                        }
                        else
                        {
                            <option value="@val">@val</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-modern w-100">
                    <i class="fa-solid fa-filter me-2"></i>Filter
                </button>
                <a asp-controller="Reports" asp-action="Expenses" class="btn btn-light btn-modern border w-100">
                    <i class="fa-solid fa-rotate-left me-2"></i>Reset
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Summary Stats & Chart row -->
<div class="row animate-fade-in delay-1 mb-4">
    <!-- Category chart -->
    <div class="col-lg-6 mb-4">
        <div class="card-modern shadow-sm h-100">
            <div class="card-header-modern">
                <h5 class="card-title-modern fw-bold"><i class="fa-solid fa-chart-pie text-primary me-2"></i>Expense Share by Category</h5>
            </div>
            <div class="card-body-modern">
                <div id="expense-share-chart" style="min-height: 250px;"></div>
            </div>
        </div>
    </div>

    <!-- Stats summary list -->
    <div class="col-lg-6 mb-4">
        <div class="card-modern shadow-sm h-100">
            <div class="card-header-modern">
                <h5 class="card-title-modern fw-bold"><i class="fa-solid fa-calculator text-primary me-2"></i>Report Summary</h5>
            </div>
            <div class="card-body-modern">
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="p-3 border rounded bg-light bg-opacity-50">
                            <span class="text-muted small fw-bold d-block">Accumulated Expenses</span>
                            <h4 class="fw-bold mb-0 text-danger">৳@ViewBag.TotalExpenseAmount.ToString("N2")</h4>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 border rounded bg-light bg-opacity-50">
                            <span class="text-muted small fw-bold d-block">Vouchers Logged</span>
                            <h4 class="fw-bold mb-0 text-primary">@Model.Count()</h4>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Category</th>
                                <th class="text-end">Total Amount (BDT)</th>
                                <th class="text-end">Share %</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.CategorySummary != null && ((System.Collections.IList)ViewBag.CategorySummary).Count > 0)
                            {
                                decimal total = ViewBag.TotalExpenseAmount;
                                foreach (dynamic item in ViewBag.CategorySummary)
                                {
                                    decimal amt = item.Amount;
                                    double share = total > 0 ? (double)(amt / total * 100) : 0;
                                    <tr>
                                        <td class="fw-bold text-main">@item.Category</td>
                                        <td class="text-end fw-semibold">৳@amt.ToString("N2")</td>
                                        <td class="text-end fw-semibold text-muted">@share.ToString("F1")%</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted">No expenses summary available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ledger Logs -->
<div class="card-modern shadow-sm animate-fade-in delay-2 mb-4">
    <div class="card-header-modern border-bottom-0 pb-0">
        <h5 class="card-title-modern fw-bold"><i class="fa-solid fa-receipt text-primary me-2"></i>Expenses Register Vouchers</h5>
    </div>
    <div class="card-body-modern p-0">
        <div class="table-responsive">
            <table class="table table-modern align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Vehicle</th>
                        <th>Description</th>
                        <th>Recorded By</th>
                        <th class="text-end">Amount (BDT)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var expense in Model)
                        {
                            <tr>
                                <td>@expense.ExpenseDate.ToString("yyyy-MM-dd")</td>
                                <td class="fw-semibold">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">@expense.ExpenseCategory</span>
                                </td>
                                <td>
                                    @if (expense.Vehicle != null)
                                    {
                                        <span>@expense.Vehicle.VehicleName (@expense.Vehicle.VehicleNumber)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">General / Overhead</span>
                                    }
                                </td>
                                <td>@expense.Description</td>
                                <td>@expense.CreatedByUser?.UserName</td>
                                <td class="text-end fw-bold text-danger">৳@expense.Amount.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No expenses records found matching selected filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Category summary chart data
            var summaryData = [];
            var summaryLabels = [];

            @if (ViewBag.CategorySummary != null)
            {
                foreach (dynamic item in ViewBag.CategorySummary)
                {
                    <text>
                        summaryData.push(@item.Amount);
                        summaryLabels.push("@item.Category");
                    </text>
                }
            }

            if (summaryData.length > 0) {
                var options = {
                    series: summaryData,
                    chart: {
                        height: 280,
                        type: 'pie',
                        fontFamily: 'Inter, sans-serif'
                    },
                    labels: summaryLabels,
                    colors: ['#ef4444', '#f59e0b', '#3b82f6', '#10b981', '#6366f1', '#ec4899', '#8b5cf6'],
                    legend: { position: 'bottom' }
                };

                var chart = new ApexCharts(document.querySelector("#expense-share-chart"), options);
                chart.render();
            } else {
                document.querySelector("#expense-share-chart").innerHTML = "<div class='text-center py-5 text-muted'>No data to plot</div>";
            }
        });
    </script>
}
