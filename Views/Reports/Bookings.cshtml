@model IEnumerable<Transport_Management_System.Models.Booking>
@{
    ViewData["Title"] = "Passenger Booking Reports";
}

<div class="page-header animate-fade-in d-print-none">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="page-title">Passenger Booking Reports</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-custom mb-0">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-primary">TMS PRO</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Reports" asp-action="Index" class="text-decoration-none text-primary">Reports Center</a></li>
                    <li class="breadcrumb-item active">Bookings</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <button onclick="window.print()" class="btn btn-outline-secondary btn-modern shadow-sm">
                <i class="fa-solid fa-print me-2"></i>Print Report
            </button>
        </div>
    </div>
</div>

<!-- Print-Only Header -->
<div class="d-none d-print-block mb-4 text-center">
    <h2 class="fw-bold">Smart Transport Management System (STMS)</h2>
    <h4>Passenger Bookings & Ticket Sales Report</h4>
    <p class="text-muted">Generated on @DateTime.Now.ToString("F") | Period: @(ViewBag.StartDate ?? "Inception") to @(ViewBag.EndDate ?? "Present")</p>
    <hr />
</div>

<!-- Filter Section -->
<div class="card-modern mb-4 animate-fade-in delay-1 d-print-none">
    <div class="card-body-modern p-4">
        <form method="get" asp-controller="Reports" asp-action="Bookings" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">Start Date</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control form-control-modern" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">End Date</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control form-control-modern" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">Booking Status</label>
                <select name="status" class="form-select form-select-modern">
                    <option value="">All Statuses</option>
                    @foreach (var val in Enum.GetValues(typeof(Transport_Management_System.Models.BookingStatus)))
                    {
                        if (ViewBag.Status != null && (Transport_Management_System.Models.BookingStatus)ViewBag.Status == (Transport_Management_System.Models.BookingStatus)val)
                        {
                            <option value="@val" selected>@val</option>
                        }
                        else
                        {
                            <option value="@val">@val</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-modern w-100">
                    <i class="fa-solid fa-filter me-2"></i>Filter
                </button>
                <a asp-controller="Reports" asp-action="Bookings" class="btn btn-light btn-modern border w-100">
                    <i class="fa-solid fa-rotate-left me-2"></i>Reset
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Summary Stats Row -->
<div class="row animate-fade-in delay-1 mb-4">
    <div class="col-6 col-lg-3 mb-3">
        <div class="card-modern border-start border-primary border-4 p-3 shadow-sm h-100">
            <p class="text-muted small mb-1 fw-bold">Report Total Bookings</p>
            <h4 class="fw-bold mb-0 text-primary">@Model.Count()</h4>
        </div>
    </div>
    <div class="col-6 col-lg-3 mb-3">
        <div class="card-modern border-start border-success border-4 p-3 shadow-sm h-100">
            <p class="text-muted small mb-1 fw-bold">Confirmed Bookings</p>
            <h4 class="fw-bold mb-0 text-success">@Model.Count(b => b.Status == Transport_Management_System.Models.BookingStatus.Confirmed)</h4>
        </div>
    </div>
    <div class="col-6 col-lg-3 mb-3">
        <div class="card-modern border-start border-warning border-4 p-3 shadow-sm h-100">
            <p class="text-muted small mb-1 fw-bold">Pending Bookings</p>
            <h4 class="fw-bold mb-0 text-warning">@Model.Count(b => b.Status == Transport_Management_System.Models.BookingStatus.Pending)</h4>
        </div>
    </div>
    <div class="col-6 col-lg-3 mb-3">
        <div class="card-modern border-start border-danger border-4 p-3 shadow-sm h-100">
            <p class="text-muted small mb-1 fw-bold">Total Sales (BDT)</p>
            <h4 class="fw-bold mb-0 text-danger">৳@Model.Where(b => b.PaymentStatus == Transport_Management_System.Models.PaymentStatus.Paid).Sum(b => b.TotalAmount).ToString("N2")</h4>
        </div>
    </div>
</div>

<!-- Report Table -->
<div class="card-modern shadow-sm animate-fade-in delay-2 mb-4">
    <div class="card-header-modern border-bottom-0 pb-0">
        <h5 class="card-title-modern fw-bold"><i class="fa-solid fa-list-check text-primary me-2"></i>Bookings Register Logs</h5>
    </div>
    <div class="card-body-modern p-0">
        <div class="table-responsive">
            <table class="table table-modern align-middle mb-0">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Booking Date</th>
                        <th>Passenger</th>
                        <th>Trip Name</th>
                        <th>Seat</th>
                        <th class="text-end">Ticket Price</th>
                        <th>Payment</th>
                        <th>Booking Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var booking in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">#@booking.BookingReference</td>
                                <td>@booking.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold">@booking.User?.UserName</span>
                                        <span class="text-muted small text-decoration-none">@booking.User?.Email</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold">@booking.Trip?.TripName</span>
                                        <span class="text-muted small">@booking.Trip?.Route?.RouteName</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">Seat @booking.SeatNumber</span></td>
                                <td class="text-end fw-semibold">৳@booking.TotalAmount.ToString("N2")</td>
                                <td>
                                    <span class="badge @(booking.PaymentStatus == Transport_Management_System.Models.PaymentStatus.Paid ? "bg-success" : booking.PaymentStatus == Transport_Management_System.Models.PaymentStatus.Pending ? "bg-warning" : "bg-danger") bg-opacity-10 text-@(booking.PaymentStatus == Transport_Management_System.Models.PaymentStatus.Paid ? "success" : booking.PaymentStatus == Transport_Management_System.Models.PaymentStatus.Pending ? "warning" : "danger") border border-@(booking.PaymentStatus == Transport_Management_System.Models.PaymentStatus.Paid ? "success" : booking.PaymentStatus == Transport_Management_System.Models.PaymentStatus.Pending ? "warning" : "danger") border-opacity-25 px-2 py-1">
                                        @booking.PaymentStatus
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(booking.Status == Transport_Management_System.Models.BookingStatus.Confirmed ? "bg-success" : booking.Status == Transport_Management_System.Models.BookingStatus.Pending ? "bg-warning" : "bg-danger") bg-opacity-10 text-@(booking.Status == Transport_Management_System.Models.BookingStatus.Confirmed ? "success" : booking.Status == Transport_Management_System.Models.BookingStatus.Pending ? "warning" : "danger") border border-@(booking.Status == Transport_Management_System.Models.BookingStatus.Confirmed ? "success" : booking.Status == Transport_Management_System.Models.BookingStatus.Pending ? "warning" : "danger") border-opacity-25 px-2 py-1">
                                        @booking.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No booking reports found matching the selected filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
