@{
    ViewData["Title"] = "Modern Transport Management";
}

<div class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 hero-content">
                <span class="section-tag animate-fade-in-up">Logistics Reimagined</span>
                <h1 class="animate-fade-in-up delay-1">Streamline Your Logistics with Precision</h1>
                <p class="hero-subtitle animate-fade-in-up delay-2">
                    The all-in-one Transport Management System for smarter vehicle tracking, 
                    efficient routing, and seamless user coordination. Elevate your business efficiency today.
                </p>
                <div class="cta-group animate-fade-in-up delay-3">
                    <a asp-controller="Account" asp-action="Register" class="btn-cta-primary">
                        Get Started <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn-cta-secondary">
                        Login to Dashboard
                    </a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-illustration animate-fade-in-up delay-2">
                    <img src="~/images/hero-illustration.png" alt="Logistics Illustration" />
                </div>
            </div>
        </div>
    </div>
</div>

<section class="features-section">
    <div class="container">
        <div class="section-title text-center mb-5">
            <span class="section-tag">Key Modules</span>
            <h2>Powerful Features for Modern Logistics</h2>
            <p class="text-muted mx-auto" style="max-width: 550px; font-size: 0.95rem;">
                Everything you need to manage your fleet, track routes, and coordinate teams in one unified platform.
            </p>
        </div>
        
        <div class="row g-4">
            <!-- Vehicle Management -->
            <div class="col-md-4">
                <div class="feature-card-premium">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-truck-fast"></i>
                    </div>
                    <h3>Vehicle Management</h3>
                    <p>Track maintenance, fuel efficiency, and fleet status with real-time updates and automated alerts.</p>
                </div>
            </div>

            <!-- Route Tracking -->
            <div class="col-md-4">
                <div class="feature-card-premium">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-map-location-dot"></i>
                    </div>
                    <h3>Route Tracking</h3>
                    <p>Optimize delivery paths, reduce transit times, and monitor real-time vehicle locations on interactive maps.</p>
                </div>
            </div>

            <!-- User Management -->
            <div class="col-md-4">
                <div class="feature-card-premium">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-users-gear"></i>
                    </div>
                    <h3>User Management</h3>
                    <p>Assign roles, manage driver schedules, and coordinate team members with a secure, centralized dashboard.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="stats-section text-center">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-3 stat-item">
                <h2>500+</h2>
                <p>Vehicles Tracked</p>
            </div>
            <div class="col-md-3 stat-item">
                <h2>1.2M</h2>
                <p>Miles Optimized</p>
            </div>
            <div class="col-md-3 stat-item">
                <h2>99.9%</h2>
                <p>Uptime Guaranteed</p>
            </div>
            <div class="col-md-3 stat-item">
                <h2>24/7</h2>
                <p>Support Ready</p>
            </div>
        </div>
    </div>
</section>
