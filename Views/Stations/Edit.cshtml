@model Transport_Management_System.Models.ViewModels.StationFormViewModel

@{
    ViewData["Title"] = "Edit Station";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary py-4 text-center">
                    <h3 class="text-white fw-bold mb-0">
                        <i class="fa-solid fa-pen-to-square me-2"></i>Edit Station
                    </h3>
                    <p class="text-white-50 mb-0">Update the details of transit hub <strong>@Model.StationName</strong></p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>
                        <input type="hidden" asp-for="StationId" />

                        <div class="row g-4">
                            <div class="col-md-12">
                                <div class="form-floating">
                                    <input asp-for="StationName" class="form-control bg-light border-0" placeholder="Station Name" />
                                    <label asp-for="StationName"></label>
                                    <span asp-validation-for="StationName" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="City" class="form-control bg-light border-0" placeholder="City" />
                                    <label asp-for="City"></label>
                                    <span asp-validation-for="City" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="District" class="form-control bg-light border-0" placeholder="District" />
                                    <label asp-for="District"></label>
                                    <span asp-validation-for="District" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-floating">
                                    <textarea asp-for="Address" class="form-control bg-light border-0" style="height: 100px" placeholder="Full Address"></textarea>
                                    <label asp-for="Address"></label>
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-floating">
                                    <textarea asp-for="Description" class="form-control bg-light border-0" style="height: 100px" placeholder="Description (Optional)"></textarea>
                                    <label asp-for="Description"></label>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-check form-switch p-3 rounded bg-light border-0 ps-5 ms-0">
                                    <input class="form-check-input ms-[-2.5em] float-start" type="checkbox" role="switch" asp-for="IsActive" />
                                    <label class="form-check-label fw-bold text-muted" asp-for="IsActive">Is Active Hub</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4 opacity-10">

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary px-5 py-3 rounded-3 shadow-sm flex-grow-1 fw-bold">
                                <i class="fa-solid fa-floppy-disk me-2"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-3 rounded-3 fw-bold">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
