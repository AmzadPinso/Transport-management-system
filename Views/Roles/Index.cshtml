@model IEnumerable<Transport_Management_System.Models.Role>

@{
    ViewData["Title"] = "Role Management";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Role Management</h1>
            <p class="text-muted mb-0">Define and manage system access levels.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 fw-bold shadow-sm">
            <i class="fa-solid fa-plus me-2"></i>Create New Role
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary-subtle text-primary rounded-circle p-3 me-3">
                                <i class="fa-solid fa-shield-halved fs-4"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">@item.RoleName</h5>
                                <small class="text-muted">ID: #@item.Id</small>
                            </div>
                        </div>
                        <p class="text-muted small mb-4" style="min-height: 40px;">
                            @(string.IsNullOrEmpty(item.RoleDescription) ? "No description provided for this role." : item.RoleDescription)
                        </p>
                        <div class="d-flex gap-2 border-top pt-3">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light flex-grow-1 rounded-3 fw-bold small text-primary">
                                <i class="fa-solid fa-pen-to-square me-2"></i>Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light flex-grow-1 rounded-3 fw-bold small text-danger">
                                <i class="fa-solid fa-trash-can me-2"></i>Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
