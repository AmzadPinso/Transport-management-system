@model Transport_Management_System.Models.Role

@{
    ViewData["Title"] = "Edit Role";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark py-4 text-center">
                    <h3 class="text-white fw-bold mb-0">
                        <i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Modify Role
                    </h3>
                    <p class="text-white-50 mb-0">Updating permissions for @Model.RoleName</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-4">
                            <div class="form-floating">
                                <input asp-for="RoleName" class="form-control bg-light border-0" placeholder="Role Name" />
                                <label asp-for="RoleName"></label>
                                <span asp-validation-for="RoleName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-floating">
                                <textarea asp-for="RoleDescription" class="form-control bg-light border-0" style="height: 120px" placeholder="Role Description">@Model.RoleDescription</textarea>
                                <label asp-for="RoleDescription"></label>
                                <span asp-validation-for="RoleDescription" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-3 pt-3">
                            <button type="submit" class="btn btn-dark px-5 py-3 rounded-3 shadow-sm flex-grow-1 fw-bold">
                                <i class="fa-solid fa-check-double me-2 text-primary"></i>Update Role
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-3 rounded-3 fw-bold">
                                Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
