@model Transport_Management_System.Models.User

@{
    ViewData["Title"] = "User Details";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">User Profile</h1>
            <p class="text-muted">Viewing account details for <span class="fw-bold">@Model.UserName</span></p>
        </div>
        <div>
            <a asp-action="Index" class="btn-modern btn-modern-secondary">
                <i class="fa-solid fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="card-modern">
        <div class="card-header-custom d-flex align-items-center justify-content-between">
            <h5 class="mb-0">
                <i class="fa-solid fa-user-gear me-2 text-primary"></i> Detailed Information
            </h5>
            @if (Model.Role != null)
            {
                var badgeClass = Model.Role.RoleName == "Admin" ? "badge-admin" : "badge-user";
                <span class="badge-modern @badgeClass">
                    <i class="fa-solid @(Model.Role.RoleName == "Admin" ? "fa-shield-halved" : "fa-user")"></i>
                    @Model.Role.RoleName
                </span>
            }
            else
            {
                <span class="badge-modern badge-default">No Role Assigned</span>
            }
        </div>
        
        <div class="card-body-custom">
            <div class="row g-4">
                <!-- User Basic Info -->
                <div class="col-md-6">
                    <div class="detail-item mb-4">
                        <span class="detail-label"><i class="fa-solid fa-id-card"></i> User Name</span>
                        <span class="detail-value">@Model.UserName</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label"><i class="fa-solid fa-envelope"></i> Email Address</span>
                        <span class="detail-value">@Model.Email</span>
                    </div>
                </div>

                <!-- User Additional Info -->
                <div class="col-md-6">
                    <div class="detail-item mb-4">
                        <span class="detail-label"><i class="fa-solid fa-location-dot"></i> Physical Address</span>
                        <span class="detail-value text-break">@(string.IsNullOrEmpty(Model.Address) ? "Not Provided" : Model.Address)</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label"><i class="fa-solid fa-clock-rotate-left"></i> Last Activity</span>
                        <span class="detail-value">@(Model.LastLogIN?.ToString("MMM dd, yyyy HH:mm") ?? "Never")</span>
                    </div>
                </div>
            </div>

            <hr class="my-4 border-light">

            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.UserId" class="btn-modern btn-modern-primary">
                    <i class="fa-solid fa-pen-to-square"></i> Edit Profile
                </a>
                <a asp-action="Delete" asp-route-id="@Model?.UserId" class="btn-modern btn-modern-danger">
                    <i class="fa-solid fa-trash"></i> Remove User
                </a>
            </div>
        </div>
    </div>
</div>
