@model Transport_Management_System.Models.User

@{
    ViewData["Title"] = "Create User";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-success py-4 text-center">
                    <h3 class="text-white fw-bold mb-0">
                        <i class="fa-solid fa-user-plus me-2"></i>Register New Employee
                    </h3>
                    <p class="text-white-50 mb-0">Create a new access account for the system</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>
                        
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="UserName" class="form-control bg-light border-0" placeholder="Username" />
                                    <label asp-for="UserName"></label>
                                    <span asp-validation-for="UserName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Email" type="email" class="form-control bg-light border-0" placeholder="name@example.com" />
                                    <label asp-for="Email"></label>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="Address" class="form-control bg-light border-0" style="height: 100px" placeholder="Physical Address"></textarea>
                                    <label asp-for="Address"></label>
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="password" name="Password" class="form-control bg-light border-0" placeholder="Password" required />
                                    <label>Initial Password</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="RoleId" class="form-select bg-light border-0" asp-items="ViewBag.RoleId">
                                        <option value="">Select Role</option>
                                    </select>
                                    <label asp-for="RoleId"></label>
                                    <span asp-validation-for="RoleId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-5 opacity-10">

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-success px-5 py-3 rounded-3 shadow-sm flex-grow-1 fw-bold">
                                <i class="fa-solid fa-user-check me-2"></i>Create Account
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-3 rounded-3 fw-bold">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
