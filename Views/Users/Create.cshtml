@model Transport_Management_System.Models.User

@{
    ViewData["Title"] = "Create User";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn-modern btn-modern-secondary me-3">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="h3 mb-0">Create New User</h1>
                    <p class="text-muted small">Fill in the details to register a new system user.</p>
                </div>
            </div>

            <div class="card-modern shadow-lg">
                <div class="card-body-custom">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="UserName" class="detail-label mb-2"><i class="fa-solid fa-user"></i> User Name</label>
                            <input asp-for="UserName" class="form-control form-control-modern" placeholder="e.g. johndoe" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email" class="detail-label mb-2"><i class="fa-solid fa-envelope"></i> Email Address</label>
                            <input asp-for="Email" class="form-control form-control-modern" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="detail-label mb-2"><i class="fa-solid fa-lock"></i> Password</label>
                            <input type="password" name="Password" class="form-control form-control-modern" placeholder="••••••••" required />
                            @Html.ValidationMessage("PasswordHash", "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="detail-label mb-2"><i class="fa-solid fa-location-dot"></i> Physical Address</label>
                            <textarea asp-for="Address" class="form-control form-control-modern" rows="2" placeholder="Street, City, Country"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="RoleId" class="detail-label mb-2"><i class="fa-solid fa-shield-halved"></i> Assign Role</label>
                            <select asp-for="RoleId" class="form-select form-control-modern" asp-items="ViewBag.RoleId">
                                <option value="" disabled selected>Select a role...</option>
                            </select>
                            <span asp-validation-for="RoleId" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mt-5">
                            <button type="submit" class="btn-modern btn-modern-primary py-3 justify-content-center">
                                <i class="fa-solid fa-user-plus"></i> Register User
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
