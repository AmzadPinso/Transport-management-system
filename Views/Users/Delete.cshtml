@model Transport_Management_System.Models.User

@{
    ViewData["Title"] = "Delete User";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <i class="fa-solid fa-user-xmark text-danger display-1"></i>
                    </div>
                    <h2 class="fw-bold text-dark mb-3">Confirm Deletion</h2>
                    <p class="text-muted fs-5 mb-4">
                        Are you sure you want to permanently remove <span class="text-danger fw-bold">@Model.UserName</span> from the system?
                    </p>
                    
                    <div class="p-3 bg-light rounded-3 mb-4 text-start">
                        <div class="row g-2">
                            <div class="col-6">
                                <small class="text-muted d-block">Role:</small>
                                <span class="fw-bold">@(Model.Role?.RoleName ?? "User")</span>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Email:</small>
                                <span class="fw-bold text-truncate d-block">@Model.Email</span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning rounded-3 text-start small mb-4">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>Warning: This employee will lose all access to the transport management portal immediately.
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="UserId" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger py-3 rounded-3 fw-bold shadow-sm">
                                <i class="fa-solid fa-user-minus me-2"></i>Confirm and Delete
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary py-3 rounded-3 fw-bold">
                                No, Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
