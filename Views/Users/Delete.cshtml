@model Transport_Management_System.Models.User

@{
    ViewData["Title"] = "Delete User";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
            <div class="mb-4">
                <div class="bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 80px; height: 80px;">
                    <i class="fa-solid fa-triangle-exclamation fs-1"></i>
                </div>
                <h1 class="h3 mb-2">Confirm Deletion</h1>
                <p class="text-muted">Are you sure you want to permanently delete this user account? This action cannot be undone.</p>
            </div>

            <div class="card-modern border-danger-subtle mb-4 shadow-sm">
                <div class="card-body-custom text-start">
                    <div class="d-flex align-items-center mb-3">
                        <div class="flex-shrink-0 bg-light rounded p-3 me-3">
                            <i class="fa-solid fa-user fs-3 text-secondary"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">@Model.UserName</h5>
                            <p class="text-muted small mb-0">@Model.Email</p>
                        </div>
                    </div>
                    
                    <div class="p-3 bg-light rounded-3">
                        <div class="detail-item">
                            <span class="detail-label small">Assigned Role</span>
                            <span class="detail-value">
                                @(Model.Role?.RoleName ?? "No Role Assigned")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <form asp-action="Delete" class="d-flex gap-2 justify-content-center">
                <input type="hidden" asp-for="UserId" />
                <button type="submit" class="btn-modern btn-modern-danger px-5">
                    <i class="fa-solid fa-trash-can"></i> Permanently Delete
                </button>
                <a asp-action="Index" class="btn-modern btn-modern-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
