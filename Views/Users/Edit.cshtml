@model Transport_Management_System.Models.User

@{
    ViewData["Title"] = "Edit User";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn-modern btn-modern-secondary me-3">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="h3 mb-0">Update User Profile</h1>
                    <p class="text-muted small">Modifying account details for <span class="fw-bold text-primary">@Model.UserName</span></p>
                </div>
            </div>

            <div class="card-modern shadow-lg border-primary-subtle">
                <div class="card-body-custom">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>
                        
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="PasswordHash" />

                        <div class="mb-4">
                            <label asp-for="UserName" class="detail-label mb-2"><i class="fa-solid fa-user"></i> User Name</label>
                            <input asp-for="UserName" class="form-control form-control-modern" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email" class="detail-label mb-2"><i class="fa-solid fa-envelope"></i> Email Address</label>
                            <input asp-for="Email" class="form-control form-control-modern" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="detail-label mb-2"><i class="fa-solid fa-lock"></i> New Password</label>
                            <input type="password" name="NewPassword" class="form-control form-control-modern" placeholder="Leave blank to keep current password" />
                            <div class="form-text small"><i class="fa-solid fa-circle-info"></i> Security Tip: Use a strong combination of letters and symbols.</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="detail-label mb-2"><i class="fa-solid fa-location-dot"></i> Physical Address</label>
                            <textarea asp-for="Address" class="form-control form-control-modern" rows="2">@Model.Address</textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="RoleId" class="detail-label mb-2"><i class="fa-solid fa-shield-halved"></i> Access Level (Role)</label>
                            <select asp-for="RoleId" class="form-select form-control-modern" asp-items="ViewBag.RoleId"></select>
                            <span asp-validation-for="RoleId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 mt-5">
                            <button type="submit" class="btn-modern btn-modern-primary flex-grow-1 justify-content-center">
                                <i class="fa-solid fa-floppy-disk"></i> Save Changes
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.UserId" class="btn-modern btn-modern-secondary">
                                <i class="fa-solid fa-circle-info"></i> View Details
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
