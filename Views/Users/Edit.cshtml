@model Transport_Management_System.Models.User

@{
    ViewData["Title"] = "Update Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary py-4 text-center">
                    <h3 class="text-white fw-bold mb-0">
                        <i class="fa-solid fa-user-pen me-2"></i>Update Employee Profile
                    </h3>
                    <p class="text-white-50 mb-0">Modify account details and security settings for @Model.UserName</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>
                        
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="PasswordHash" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="UserName" class="form-control bg-light border-0" placeholder="Username" />
                                    <label asp-for="UserName"></label>
                                    <span asp-validation-for="UserName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Email" type="email" class="form-control bg-light border-0" placeholder="name@example.com" />
                                    <label asp-for="Email"></label>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="Address" class="form-control bg-light border-0" style="height: 100px" placeholder="Physical Address">@Model.Address</textarea>
                                    <label asp-for="Address"></label>
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="p-3 bg-light rounded-3 border-start border-4 border-warning">
                                    <h6 class="fw-bold mb-3"><i class="fa-solid fa-shield-halved me-2 text-warning"></i>Security & Permissions</h6>
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <label asp-for="RoleId" class="form-label text-muted small fw-bold mb-1">Access Level</label>
                                                <select asp-for="RoleId" class="form-select border-0 shadow-sm" asp-items="ViewBag.RoleId"></select>
                                                <span asp-validation-for="RoleId" class="text-danger small"></span>
                                            </div>
                                        </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-5 opacity-10">

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary px-5 py-3 rounded-3 shadow-sm flex-grow-1 fw-bold">
                                <i class="fa-solid fa-floppy-disk me-2"></i>Save Profile Changes
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary px-4 py-3 rounded-3 fw-bold">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
