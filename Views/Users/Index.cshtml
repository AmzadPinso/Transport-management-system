@model IEnumerable<Transport_Management_System.Models.User>

@{
    ViewData["Title"] = "User Management";
    string search = ViewBag.Search ?? "";
    int pageNumber = ViewBag.PageNumber;
    int pageSize = ViewBag.PageSize;
    string sortColumn = ViewBag.SortColumn;
    string sortDirection = ViewBag.SortDirection;
    int totalPages = ViewBag.TotalPages;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="h2 mb-1">User Management</h1>
            <p class="text-muted small mb-0">System access control and user administration dashboard.</p>
        </div>
        <a asp-action="Create" class="btn-modern btn-modern-primary btn-modern-sm shadow-sm">
            <i class="fa-solid fa-user-plus"></i> Create New User
        </a>
    </div>

    <!-- Compact Search Section -->
    <div class="search-card-compact p-3">
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <div class="search-input-group flex-grow-1">
                <i class="fa-solid fa-magnifying-glass search-icon-inside"></i>
                <input type="text" name="search" value="@search" 
                       class="form-control form-control-search" 
                       placeholder="Search name, email or address..." />
            </div>
            <button type="submit" class="btn-modern btn-modern-primary btn-search-apply px-4">
                <i class="fa-solid fa-filter me-1"></i> Apply
            </button>
            @if (!string.IsNullOrEmpty(search))
            {
                <a asp-action="Index" class="btn-modern btn-modern-secondary btn-search-apply px-3">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            }
        </form>
    </div>

    <!-- Table Section -->
    <div class="table-container">
        <table class="table table-modern mb-0">
            <thead>
                <tr>
                    <th>
                        <a class="text-decoration-none text-muted" asp-action="Index" asp-route-search="@search" asp-route-sortColumn="UserName" asp-route-sortDirection="@(sortColumn == "UserName" && sortDirection == "ASC" ? "DESC" : "ASC")">
                            User @(sortColumn == "UserName" ? (sortDirection == "ASC" ? "↑" : "↓") : "")
                        </a>
                    </th>
                    <th>
                        <a class="text-decoration-none text-muted" asp-action="Index" asp-route-search="@search" asp-route-sortColumn="Email" asp-route-sortDirection="@(sortColumn == "Email" && sortDirection == "ASC" ? "DESC" : "ASC")">
                            Email @(sortColumn == "Email" ? (sortDirection == "ASC" ? "↑" : "↓") : "")
                        </a>
                    </th>
                    <th>Role</th>
                    <th>Last Login</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-folder-open d-block fs-2 mb-2 opacity-50"></i>
                            No users match your search criteria.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.UserName</td>
                        <td class="text-secondary">@item.Email</td>
                        <td>
                            @{
                                var roleName = item.Role?.RoleName ?? "No Role";
                                var badgeClass = roleName == "Admin" ? "badge-admin" : (roleName == "User" ? "badge-user" : "badge-default");
                            }
                            <span class="badge-modern @badgeClass">
                                <i class="fa-solid @(roleName == "Admin" ? "fa-shield-halved" : "fa-user")"></i>
                                @roleName
                            </span>
                        </td>
                        <td class="text-muted small">
                            @(item.LastLogIN?.ToString("MMM dd, yyyy") ?? "—")
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-warning rounded-pill" title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-info rounded-pill" title="Details">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-danger rounded-pill" title="Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination">
                    <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                        <a class="page-link border-0 rounded-start shadow-sm" asp-action="Index" asp-route-pageNumber="@(pageNumber - 1)" asp-route-search="@search" asp-route-sortColumn="@sortColumn" asp-route-sortDirection="@sortDirection">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    </li>
                    
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item mx-1">
                            <a class="page-link border-0 shadow-sm rounded @(i == pageNumber ? "bg-primary text-white" : "bg-white text-dark")" asp-action="Index" asp-route-pageNumber="@i" asp-route-search="@search" asp-route-sortColumn="@sortColumn" asp-route-sortDirection="@sortDirection">@i</a>
                        </li>
                    }

                    <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                        <a class="page-link border-0 rounded-end shadow-sm" asp-action="Index" asp-route-pageNumber="@(pageNumber + 1)" asp-route-search="@search" asp-route-sortColumn="@sortColumn" asp-route-sortDirection="@sortDirection">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
