@model Transport_Management_System.Models.ViewModels.ExpenseFormViewModel
@using Transport_Management_System.Models

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="m-0 font-weight-bold"><i class="fas fa-wallet mr-2"></i>Record Operational Expense</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="VehicleId" class="form-label font-weight-bold"></label>
                                <select asp-for="VehicleId" asp-items="Model.VehicleList" class="form-select">
                                    <option value="">-- General / Non-Vehicle --</option>
                                </select>
                                <span asp-validation-for="VehicleId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ExpenseCategory" class="form-label font-weight-bold"></label>
                                <select asp-for="ExpenseCategory" asp-items="Html.GetEnumSelectList<ExpenseCategory>()" class="form-select">
                                    <option value="">-- Choose Category --</option>
                                </select>
                                <span asp-validation-for="ExpenseCategory" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Amount" class="form-label font-weight-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">৳</span>
                                    <input asp-for="Amount" class="form-control" type="number" step="0.01" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ExpenseDate" class="form-label font-weight-bold"></label>
                                <input asp-for="ExpenseDate" class="form-control" type="date" />
                                <span asp-validation-for="ExpenseDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label font-weight-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Brief notes e.g., 'Fuel refilled 50L', 'Replaced engine belts Dhaka Workshop'..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-arrow-left mr-2"></i>Back to List
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                <i class="fas fa-save mr-2"></i>Record Expense
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
