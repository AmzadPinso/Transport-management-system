@model Transport_Management_System.Models.Shipment

@{
    ViewData["Title"] = "Delete Shipment";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center"
                             style="width: 80px; height: 80px;">
                            <i class="fa-solid fa-trash-can text-danger fs-2"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold mb-2">Delete Shipment?</h4>
                    <p class="text-muted mb-1">You are about to permanently delete:</p>
                    <p class="fw-bold text-primary fs-5 mb-1">@Model.ShipmentRef</p>
                    <p class="text-muted small mb-4">
                        @Model.SenderName → @Model.ReceiverName<br />
                        @Model.Origin → @Model.Destination
                    </p>
                    <div class="alert alert-warning rounded-3 text-start mb-4">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                        <strong>This action cannot be undone.</strong> All shipment data will be permanently removed.
                    </div>
                    <form asp-action="Delete" method="post" class="d-flex gap-3 justify-content-center">
                        <input type="hidden" asp-for="ShipmentId" />
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4">
                            <i class="fa-solid fa-arrow-left me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-danger rounded-3 px-4">
                            <i class="fa-solid fa-trash-can me-1"></i>Delete Permanently
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
