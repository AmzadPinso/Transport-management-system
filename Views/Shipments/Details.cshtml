@model Transport_Management_System.Models.Shipment
@using Transport_Management_System.Models

@{
    ViewData["Title"] = "Shipment Details";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <div>
            <h1 class="h3 fw-bold mb-0">Shipment Details</h1>
            <p class="text-muted small mb-0">Ref: <strong class="text-primary">@Model.ShipmentRef</strong></p>
        </div>
        <div class="ms-auto d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.ShipmentId" class="btn btn-outline-primary rounded-3">
                <i class="fa-solid fa-pen-to-square me-1"></i>Edit
            </a>
            <a asp-action="Delete" asp-route-id="@Model.ShipmentId" class="btn btn-outline-danger rounded-3">
                <i class="fa-solid fa-trash-can me-1"></i>Delete
            </a>
        </div>
    </div>

    @{
        var (statusClass, statusIcon) = Model.Status switch
        {
            ShipmentStatus.Delivered      => ("success", "fa-circle-check"),
            ShipmentStatus.InTransit      => ("info", "fa-truck-moving"),
            ShipmentStatus.Dispatched     => ("primary", "fa-paper-plane"),
            ShipmentStatus.OutForDelivery => ("warning", "fa-person-biking"),
            ShipmentStatus.Pending        => ("secondary", "fa-clock"),
            ShipmentStatus.Processing     => ("primary", "fa-gears"),
            ShipmentStatus.Failed         => ("danger", "fa-triangle-exclamation"),
            ShipmentStatus.Cancelled      => ("danger", "fa-ban"),
            ShipmentStatus.Returned       => ("warning", "fa-rotate-left"),
            _                             => ("secondary", "fa-circle")
        };
    }

    <!-- Status Banner -->
    <div class="alert alert-@statusClass border-0 rounded-4 mb-4 d-flex align-items-center gap-3 shadow-sm">
        <i class="fa-solid @statusIcon fs-4"></i>
        <div>
            <div class="fw-bold">Status: @Model.Status</div>
            <div class="small opacity-75">
                @if (Model.Status == ShipmentStatus.Delivered && Model.ActualDelivery.HasValue)
                { @($"Delivered on {Model.ActualDelivery.Value:MMM dd, yyyy}") }
                else if (Model.ExpectedDelivery.HasValue)
                { @($"Expected by {Model.ExpectedDelivery.Value:MMM dd, yyyy}") }
                else
                { <text>No delivery date set</text> }
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left: Core Info -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-people-arrows me-2"></i>Sender & Receiver</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="small text-muted mb-1">Sender</div>
                                <div class="fw-bold">@Model.SenderName</div>
                                <div class="small text-muted">@Model.SenderContact</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <div class="small text-muted mb-1">Receiver</div>
                                <div class="fw-bold">@Model.ReceiverName</div>
                                <div class="small text-muted">@Model.ReceiverContact</div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-route me-2"></i>Route</h6>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div class="p-3 bg-danger bg-opacity-10 rounded-3 flex-fill">
                            <div class="small text-muted mb-1"><i class="fa-solid fa-location-dot text-danger me-1"></i>Origin</div>
                            <div class="fw-bold">@Model.Origin</div>
                        </div>
                        <i class="fa-solid fa-arrow-right text-muted fs-5"></i>
                        <div class="p-3 bg-success bg-opacity-10 rounded-3 flex-fill">
                            <div class="small text-muted mb-1"><i class="fa-solid fa-flag-checkered text-success me-1"></i>Destination</div>
                            <div class="fw-bold">@Model.Destination</div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-box me-2"></i>Cargo</h6>
                    <p class="text-muted">@Model.Description</p>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="alert alert-light border rounded-3 mt-3">
                            <i class="fa-solid fa-note-sticky me-2 text-muted"></i>
                            <small>@Model.Notes</small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right: KPI Cards -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">
                    <div class="small text-muted mb-1">Type</div>
                    <div class="fw-bold fs-5">@Model.ShipmentType</div>
                </div>
            </div>
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">
                    <div class="small text-muted mb-1">Weight</div>
                    <div class="fw-bold fs-5">@Model.WeightKg.ToString("F2") <small class="text-muted fs-6">kg</small></div>
                </div>
            </div>
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">
                    <div class="small text-muted mb-1">Freight Charge</div>
                    <div class="fw-bold fs-5 text-success">BDT @Model.FreightCharge.ToString("N2")</div>
                </div>
            </div>
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">
                    <div class="small text-muted mb-1">Assigned Vehicle</div>
                    <div class="fw-bold">@(Model.Vehicle?.VehicleName ?? "Not Assigned")</div>
                    @if (Model.Vehicle != null)
                    {
                        <div class="small text-muted">@Model.Vehicle.VehicleNumber</div>
                    }
                </div>
            </div>
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="small text-muted mb-2">Timeline</div>
                    <div class="d-flex flex-column gap-2 small">
                        <div><span class="text-muted">Created:</span> @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                        <div><span class="text-muted">Dispatch:</span> @(Model.DispatchDate.HasValue ? Model.DispatchDate.Value.ToString("MMM dd, yyyy") : "—")</div>
                        <div><span class="text-muted">Expected:</span> @(Model.ExpectedDelivery.HasValue ? Model.ExpectedDelivery.Value.ToString("MMM dd, yyyy") : "—")</div>
                        <div><span class="text-muted">Delivered:</span> @(Model.ActualDelivery.HasValue ? Model.ActualDelivery.Value.ToString("MMM dd, yyyy") : "—")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
