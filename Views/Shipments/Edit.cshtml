@model Transport_Management_System.Models.Shipment
@using Transport_Management_System.Models

@{
    ViewData["Title"] = "Edit Shipment";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <div>
            <h1 class="h3 fw-bold mb-0">Edit Shipment</h1>
            <p class="text-muted small mb-0">Ref: <strong>@Model.ShipmentRef</strong></p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-9">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="ShipmentId" />
                        <input type="hidden" asp-for="ShipmentRef" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>

                        <!-- Sender / Receiver -->
                        <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-people-arrows me-2"></i>Sender & Receiver</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="SenderName" class="form-label fw-semibold"></label>
                                <input asp-for="SenderName" class="form-control rounded-3" />
                                <span asp-validation-for="SenderName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SenderContact" class="form-label fw-semibold"></label>
                                <input asp-for="SenderContact" class="form-control rounded-3" />
                                <span asp-validation-for="SenderContact" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ReceiverName" class="form-label fw-semibold"></label>
                                <input asp-for="ReceiverName" class="form-control rounded-3" />
                                <span asp-validation-for="ReceiverName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ReceiverContact" class="form-label fw-semibold"></label>
                                <input asp-for="ReceiverContact" class="form-control rounded-3" />
                                <span asp-validation-for="ReceiverContact" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Route -->
                        <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-route me-2"></i>Origin & Destination</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Origin" class="form-label fw-semibold"></label>
                                <input asp-for="Origin" class="form-control rounded-3" />
                                <span asp-validation-for="Origin" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Destination" class="form-label fw-semibold"></label>
                                <input asp-for="Destination" class="form-control rounded-3" />
                                <span asp-validation-for="Destination" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Cargo Details -->
                        <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-box me-2"></i>Cargo Details</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold"></label>
                                <textarea asp-for="Description" class="form-control rounded-3" rows="2"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ShipmentType" class="form-label fw-semibold"></label>
                                <select asp-for="ShipmentType" class="form-select rounded-3"
                                        asp-items="Html.GetEnumSelectList<ShipmentType>()"></select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="WeightKg" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="WeightKg" type="number" step="0.01" min="0.01" class="form-control rounded-start-3" />
                                    <span class="input-group-text bg-light border-start-0">kg</span>
                                </div>
                                <span asp-validation-for="WeightKg" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FreightCharge" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">BDT</span>
                                    <input asp-for="FreightCharge" type="number" step="0.01" min="0" class="form-control rounded-end-3" />
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Dispatch & Assignment -->
                        <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-truck me-2"></i>Dispatch & Assignment</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label fw-semibold"></label>
                                <select asp-for="Status" class="form-select rounded-3"
                                        asp-items="Html.GetEnumSelectList<ShipmentStatus>()"></select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="VehicleId" class="form-label fw-semibold"></label>
                                <select asp-for="VehicleId" class="form-select rounded-3" asp-items="ViewBag.Vehicles">
                                    <option value="">-- None --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DispatchDate" class="form-label fw-semibold"></label>
                                <input asp-for="DispatchDate" type="date" class="form-control rounded-3" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ExpectedDelivery" class="form-label fw-semibold"></label>
                                <input asp-for="ExpectedDelivery" type="date" class="form-control rounded-3" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ActualDelivery" class="form-label fw-semibold"></label>
                                <input asp-for="ActualDelivery" type="date" class="form-control rounded-3" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Notes" class="form-label fw-semibold"></label>
                                <input asp-for="Notes" class="form-control rounded-3" placeholder="Optional notes..." />
                            </div>
                        </div>

                        <div class="d-flex gap-3 justify-content-end mt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4">Cancel</a>
                            <button type="submit" class="btn-modern btn-modern-primary px-5">
                                <i class="fa-solid fa-floppy-disk me-2"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
