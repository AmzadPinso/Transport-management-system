@model Transport_Management_System.Models.Booking

@{
    ViewData["Title"] = $"Booking - {Model.BookingReference}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="h3 fw-bold mb-1 font-monospace">@Model.BookingReference</h1>
                <p class="text-muted small mb-0">Booked on @Model.BookingDate.ToString("MMMM dd, yyyy hh:mm tt")</p>
            </div>
        </div>
        <a asp-controller="Bookings" asp-action="Ticket" asp-route-id="@Model.BookingId"
           class="btn btn-outline-primary rounded-3 px-4">
            <i class="fa-solid fa-ticket me-2"></i>View Ticket
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left Column -->
        <div class="col-lg-8">
            <!-- Passenger Info -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-user text-primary me-2"></i>Passenger Information</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <span class="text-muted small d-block">Full Name</span>
                            <strong>@Model.User?.UserName</strong>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted small d-block">Email</span>
                            <strong>@Model.User?.Email</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Trip Info -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-calendar-days text-primary me-2"></i>Trip Information</h5>
                    <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 mb-3">
                        <div class="text-center">
                            <div class="text-muted small">FROM</div>
                            <div class="fw-bold">@Model.Trip?.Route?.OriginStation?.StationName</div>
                        </div>
                        <i class="fa-solid fa-arrow-right-long text-primary fs-4"></i>
                        <div class="text-center">
                            <div class="text-muted small">TO</div>
                            <div class="fw-bold">@Model.Trip?.Route?.DestinationStation?.StationName</div>
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-3"><span class="text-muted small d-block">Trip</span><strong class="small">@Model.Trip?.TripName</strong></div>
                        <div class="col-md-3"><span class="text-muted small d-block">Date</span><strong class="small">@Model.Trip?.DepartureDate.ToString("MMM dd, yyyy")</strong></div>
                        <div class="col-md-3"><span class="text-muted small d-block">Departs</span><strong class="small">@(Model.Trip != null ? DateTime.Today.Add(Model.Trip.DepartureTime).ToString("hh:mm tt") : "-")</strong></div>
                        <div class="col-md-3"><span class="text-muted small d-block">Seat</span><strong class="text-primary">@Model.SeatNumber</strong></div>
                    </div>
                </div>
            </div>

            <!-- Vehicle & Driver -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-truck text-primary me-2"></i>Vehicle & Driver</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <span class="text-muted small d-block">Vehicle</span>
                            <strong>@Model.Trip?.Vehicle?.VehicleName</strong>
                            <div class="text-muted small">@Model.Trip?.Vehicle?.VehicleNumber</div>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted small d-block">Driver</span>
                            <strong>@Model.Trip?.Driver?.FullName</strong>
                            <div class="text-muted small">@Model.Trip?.Driver?.PhoneNumber</div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Remarks))
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-2"><i class="fa-solid fa-comment-dots text-primary me-2"></i>Remarks</h5>
                        <p class="mb-0">@Model.Remarks</p>
                    </div>
                </div>
            }
        </div>

        <!-- Right Column: Admin Controls -->
        <div class="col-lg-4">
            <!-- Status Panel -->
            <div class="card border-0 shadow-sm rounded-4 bg-dark text-white mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 text-secondary small text-uppercase">Booking Status</h5>
                    <div class="mb-3">
                        <span class="text-muted small d-block">CURRENT STATUS</span>
                        <span class="fs-4 fw-bold text-warning">@Model.Status</span>
                    </div>
                    <form asp-action="UpdateStatus" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookingId" value="@Model.BookingId" />
                        <select name="status" class="form-select mb-2 rounded-3" asp-items="Html.GetEnumSelectList<BookingStatus>()"></select>
                        <button type="submit" class="btn btn-warning w-100 rounded-3 fw-bold text-dark">
                            <i class="fa-solid fa-arrows-rotate me-2"></i>Update Status
                        </button>
                    </form>
                </div>
            </div>

            <!-- Payment Panel -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 text-secondary small text-uppercase">Payment Status</h5>
                    <div class="mb-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Amount</span>
                        <strong class="text-success fs-5">
                            @(Model.TotalAmount > 0 ? $"৳{Model.TotalAmount:N0}" : "FREE")
                        </strong>
                    </div>
                    <div class="mb-3">
                        <span class="text-muted small d-block">Current Payment</span>
                        <span class="fw-bold">@Model.PaymentStatus</span>
                    </div>
                    <form asp-action="UpdatePaymentStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookingId" value="@Model.BookingId" />
                        <select name="paymentStatus" class="form-select mb-2 rounded-3" asp-items="Html.GetEnumSelectList<PaymentStatus>()"></select>
                        <button type="submit" class="btn btn-success w-100 rounded-3 fw-bold">
                            <i class="fa-solid fa-circle-dollar-to-slot me-2"></i>Update Payment
                        </button>
                    </form>
                </div>
            </div>

            <!-- Cancellation Info -->
            @if (Model.Status == BookingStatus.Cancelled)
            {
                <div class="card border-0 shadow-sm rounded-4 border-danger">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-2 text-danger"><i class="fa-solid fa-circle-xmark me-2"></i>Cancellation</h5>
                        <div class="mb-2"><span class="text-muted small d-block">Cancelled At</span><strong>@Model.CancelledAt?.ToString("MMM dd, yyyy hh:mm tt")</strong></div>
                        @if (!string.IsNullOrEmpty(Model.CancellationReason))
                        {
                            <div><span class="text-muted small d-block">Reason</span><strong>@Model.CancellationReason</strong></div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
