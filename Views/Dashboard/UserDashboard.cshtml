@model Transport_Management_System.Models.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "User Portal Dashboard";
}

<div class="page-header animate-fade-in">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="page-title">Welcome back, @(Model.UserProfile?.UserName ?? User.Identity?.Name ?? "Valued Customer")</h1>
            <p class="text-muted mb-0">Manage your ticket bookings, view upcoming trips, and explore smart seat recommendations.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-controller="Bookings" asp-action="Index" class="btn btn-primary btn-modern shadow-sm">
                <i class="fa-solid fa-ticket me-2"></i> Book New Trip
            </a>
        </div>
    </div>
</div>

<!-- User KPI Widgets -->
<div class="stats-grid animate-fade-in delay-1 mb-4">
    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Total Bookings</p>
            <h3 class="stat-value">@Model.TotalBookingsCount</h3>
            <div class="stat-trend trend-up">
                <i class="fa-solid fa-clock-rotate-left"></i>
                <span>Lifetime ticket reservations</span>
            </div>
        </div>
        <div class="stat-icon bg-primary-subtle text-primary">
            <i class="fa-solid fa-ticket"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Confirmed Trips</p>
            <h3 class="stat-value">@Model.ConfirmedBookingsCount</h3>
            <div class="stat-trend trend-up">
                <i class="fa-solid fa-calendar-check"></i>
                <span>Active &amp; completed trips</span>
            </div>
        </div>
        <div class="stat-icon bg-success-subtle text-success">
            <i class="fa-solid fa-circle-check"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Upcoming Travel</p>
            <h3 class="stat-value">@Model.UpcomingBookings.Count</h3>
            <div class="stat-trend trend-up">
                <i class="fa-solid fa-bus"></i>
                <span>Scheduled upcoming journeys</span>
            </div>
        </div>
        <div class="stat-icon bg-warning-subtle text-warning">
            <i class="fa-solid fa-clock"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Total Invested</p>
            <h3 class="stat-value">$@Model.TotalSpent.ToString("N2")</h3>
            <div class="stat-trend trend-up">
                <i class="fa-solid fa-receipt"></i>
                <span>Paid ticket amount</span>
            </div>
        </div>
        <div class="stat-icon bg-info-subtle text-info">
            <i class="fa-solid fa-wallet"></i>
        </div>
    </div>
</div>

<div class="row g-4 animate-fade-in delay-2">
    <!-- Upcoming Trips Section -->
    <div class="col-lg-8">
        <div class="card-modern p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa-solid fa-calendar-days text-primary me-2"></i> Upcoming Booked Trips
                </h5>
                <a asp-controller="Bookings" asp-action="History" class="btn btn-sm btn-outline-primary rounded-pill">
                    View All History <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>

            @if (Model.UpcomingBookings.Any())
            {
                <div class="table-responsive">
                    <table class="table table-custom align-middle">
                        <thead>
                            <tr>
                                <th>Ref #</th>
                                <th>Route / Departure</th>
                                <th>Seat</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model.UpcomingBookings)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold text-primary">@booking.BookingReference</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-main">
                                            @(booking.Trip?.Route?.OriginStation?.StationName ?? "Origin") 
                                            <i class="fa-solid fa-arrow-right x-small text-muted mx-1"></i> 
                                            @(booking.Trip?.Route?.DestinationStation?.StationName ?? "Destination")
                                        </div>
                                        <small class="text-muted">
                                            <i class="fa-solid fa-clock me-1"></i>
                                            @(booking.Trip?.DepartureDate.ToString("MMM dd, yyyy") ?? "") @(booking.Trip?.DepartureTime.ToString(@"hh\:mm") ?? "")
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-20 text-main border border-secondary border-opacity-25 px-2 py-1">
                                            Seat @booking.SeatNumber
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                            @booking.Status
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-controller="Bookings" asp-action="Ticket" asp-route-id="@booking.BookingId" class="btn btn-sm btn-primary rounded-2">
                                            <i class="fa-solid fa-qrcode me-1"></i> QR Ticket
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="fa-solid fa-ticket fs-1 mb-2 text-secondary opacity-50"></i>
                    <p class="mb-2">No upcoming booked trips scheduled.</p>
                    <a asp-controller="Bookings" asp-action="Index" class="btn btn-sm btn-primary">
                        Browse &amp; Book Trips Now
                    </a>
                </div>
            }
        </div>

        <!-- Quick Booking & Recommended Seats -->
        <div class="card-modern p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa-solid fa-wand-magic-sparkles text-accent me-2"></i> Recommended Trips &amp; Smart Seats
                </h5>
                <a asp-controller="Routes" asp-action="Calculator" class="btn btn-sm btn-outline-secondary rounded-pill">
                    <i class="fa-solid fa-map-location-dot me-1"></i> Distance Map
                </a>
            </div>

            @if (Model.AvailableTrips.Any())
            {
                <div class="row g-3">
                    @foreach (var trip in Model.AvailableTrips)
                    {
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 border border-light bg-dark-subtle hover-shadow transition-all">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="fw-bold text-main mb-0">@trip.TripName</h6>
                                    <span class="badge bg-primary text-white">$@trip.TicketPrice.ToString("F2")</span>
                                </div>
                                <p class="small text-muted mb-2">
                                    <i class="fa-solid fa-route me-1 text-primary"></i>
                                    @(trip.Route?.OriginStation?.StationName ?? "Origin") &rarr; @(trip.Route?.DestinationStation?.StationName ?? "Destination")
                                </p>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top border-light">
                                    <small class="text-muted">
                                        <i class="fa-solid fa-couch me-1"></i> @trip.AvailableCapacity seats free
                                    </small>
                                    <a asp-controller="Bookings" asp-action="SelectSeat" asp-route-id="@trip.TripId" class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-chair me-1"></i> Select Seat
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small mb-0">No active trips scheduled at this moment. Check back soon!</p>
            }
        </div>
    </div>

    <!-- Right Column: Profile Summary & Quick Links -->
    <div class="col-lg-4">
        <!-- Profile Card -->
        <div class="card-modern p-4 mb-4 text-center">
            <div class="user-avatar mx-auto mb-3" style="width: 70px; height: 70px; font-size: 28px; background: linear-gradient(135deg, #0ea5e9, #4f46e5); color: #ffffff; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                @(Model.UserProfile?.UserName?.Substring(0, 1).ToUpper() ?? "U")
            </div>
            <h5 class="fw-bold text-main mb-1">@(Model.UserProfile?.UserName ?? "User Account")</h5>
            <p class="text-muted small mb-3">@(Model.UserProfile?.Email ?? "No email provided")</p>
            <div class="d-flex justify-content-center gap-2 mb-3">
                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-1">
                    Customer Account
                </span>
            </div>
            <hr class="my-3 opacity-25">
            <div class="d-grid gap-2">
                <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    <i class="fa-solid fa-user-gear me-1"></i> Edit Profile &amp; Password
                </a>
            </div>
        </div>

        <!-- Recent Booking History Brief -->
        <div class="card-modern p-4">
            <h6 class="fw-bold mb-3">
                <i class="fa-solid fa-clock-rotate-left text-info me-2"></i> Recent History
            </h6>
            @if (Model.RecentBookings.Any())
            {
                <ul class="list-group list-group-flush bg-transparent">
                    @foreach (var booking in Model.RecentBookings.Take(5))
                    {
                        <li class="list-group-item bg-transparent px-0 py-2 border-bottom border-light d-flex justify-content-between align-items-center">
                            <div>
                                <p class="mb-0 small fw-bold text-main">@booking.BookingReference</p>
                                <span class="x-small text-muted">@booking.BookingDate.ToString("MMM dd, yyyy")</span>
                            </div>
                            <span class="badge @(booking.Status == Transport_Management_System.Models.BookingStatus.Confirmed ? "bg-success" : booking.Status == Transport_Management_System.Models.BookingStatus.Pending ? "bg-warning text-dark" : "bg-danger") bg-opacity-10 text-main border px-2 py-1 x-small">
                                @booking.Status
                            </span>
                        </li>
                    }
                </ul>
                <div class="mt-3 text-center">
                    <a asp-controller="Bookings" asp-action="History" class="small text-primary text-decoration-none fw-bold">
                        View Full History &rarr;
                    </a>
                </div>
            }
            else
            {
                <p class="text-muted x-small mb-0">No past bookings found.</p>
            }
        </div>
    </div>
</div>
