@{
    ViewData["Title"] = "Executive Dashboard";
}

<div class="page-header animate-fade-in">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="page-title">Dashboard Overview</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-custom mb-0">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-primary">TMS PRO</a></li>
                    <li class="breadcrumb-item active">Dashboard</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <button class="btn btn-primary btn-modern shadow-sm">
                <i class="fa-solid fa-plus me-2"></i> New Shipment
            </button>
        </div>
    </div>
</div>

<!-- KPI Widgets -->
<div class="stats-grid animate-fade-in delay-1">
    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Total Vehicles</p>
            <h3 class="stat-value">124</h3>
            <div class="stat-trend trend-up">
                <i class="fa-solid fa-arrow-up"></i>
                <span>4.5% from last month</span>
            </div>
        </div>
        <div class="stat-icon bg-primary-subtle text-primary">
            <i class="fa-solid fa-truck"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Drivers Overview</p>
            <h3 class="stat-value">@ViewBag.TotalDrivers</h3>
            <div class="stat-trend trend-up">
                <i class="fa-solid fa-user-check"></i>
                <span>@ViewBag.AvailableDrivers Available, @ViewBag.DriversOnTrip On Trip</span>
            </div>
            @if(ViewBag.ExpiredLicenses > 0 || ViewBag.ExpiringLicenses > 0)
            {
                <div class="mt-3 pt-2 border-top border-light d-flex flex-wrap gap-2 small fw-bold">
                    @if(ViewBag.ExpiredLicenses > 0)
                    {
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1"><i class="fa-solid fa-triangle-exclamation me-1"></i> @ViewBag.ExpiredLicenses Expired</span>
                    }
                    @if(ViewBag.ExpiringLicenses > 0)
                    {
                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1"><i class="fa-solid fa-clock me-1"></i> @ViewBag.ExpiringLicenses Expiring Soon</span>
                    }
                </div>
            }
        </div>
        <div class="stat-icon bg-success-subtle text-success">
            <i class="fa-solid fa-id-card"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Total Routes</p>
            <h3 class="stat-value">@ViewBag.TotalRoutes</h3>
            <div class="stat-trend trend-up">
                <i class="fa-solid fa-route"></i>
                <span>@ViewBag.ActiveRoutes Active Routes</span>
            </div>
        </div>
        <div class="stat-icon bg-warning-subtle text-warning">
            <i class="fa-solid fa-route"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Total Stations</p>
            <h3 class="stat-value">@ViewBag.TotalStations</h3>
            <div class="stat-trend trend-up">
                <i class="fa-solid fa-location-dot"></i>
                <span>@ViewBag.ActiveStations Active Hubs</span>
            </div>
        </div>
        <div class="stat-icon bg-info-subtle text-info">
            <i class="fa-solid fa-location-dot"></i>
        </div>
    </div>
</div>

<!-- Trip Operations KPI Grid -->
<h4 class="mt-4 mb-3 animate-fade-in delay-1 fw-bold"><i class="fa-solid fa-calendar-days text-primary me-2"></i>Trip Operations Summary</h4>
<div class="stats-grid animate-fade-in delay-1 mb-4">
    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Total Trips</p>
            <h3 class="stat-value">@ViewBag.TotalTrips</h3>
            <div class="stat-trend text-muted small">
                <i class="fa-solid fa-route"></i>
                <span>Active operational trips</span>
            </div>
        </div>
        <div class="stat-icon bg-primary-subtle text-primary">
            <i class="fa-solid fa-calendar-days"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Scheduled & Ready</p>
            <h3 class="stat-value">@(ViewBag.ScheduledTrips + ViewBag.ReadyForDispatchTrips)</h3>
            <div class="stat-trend text-muted small">
                <i class="fa-solid fa-clock"></i>
                <span>@ViewBag.ScheduledTrips Scheduled, @ViewBag.ReadyForDispatchTrips Ready</span>
            </div>
        </div>
        <div class="stat-icon bg-info-subtle text-info">
            <i class="fa-solid fa-clock"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Ongoing / Delayed</p>
            <h3 class="stat-value">@ViewBag.OngoingTrips</h3>
            <div class="stat-trend text-warning small">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>@ViewBag.DelayedTrips Delayed Trips</span>
            </div>
        </div>
        <div class="stat-icon bg-warning-subtle text-warning">
            <i class="fa-solid fa-truck-fast"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Completed & Cancelled</p>
            <h3 class="stat-value">@ViewBag.CompletedTrips</h3>
            <div class="stat-trend text-danger small">
                <i class="fa-solid fa-circle-xmark"></i>
                <span>@ViewBag.CancelledTrips Cancelled Trips</span>
            </div>
        </div>
        <div class="stat-icon bg-success-subtle text-success">
            <i class="fa-solid fa-circle-check"></i>
        </div>
    </div>
</div>

<!-- Booking & Ticketing Summary -->
<h4 class="mt-4 mb-3 animate-fade-in delay-1 fw-bold"><i class="fa-solid fa-ticket text-primary me-2"></i>Booking & Ticketing Summary</h4>
<div class="stats-grid animate-fade-in delay-1 mb-4">
    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Total Bookings</p>
            <h3 class="stat-value">@ViewBag.TotalBookings</h3>
            <div class="stat-trend text-muted small">
                <i class="fa-solid fa-receipt"></i>
                <span>Overall passenger reservations</span>
            </div>
        </div>
        <div class="stat-icon bg-primary-subtle text-primary">
            <i class="fa-solid fa-ticket"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Confirmed Bookings</p>
            <h3 class="stat-value">@ViewBag.ConfirmedBookings</h3>
            <div class="stat-trend text-success small">
                <i class="fa-solid fa-circle-check"></i>
                <span>Ready for departure</span>
            </div>
        </div>
        <div class="stat-icon bg-success-subtle text-success">
            <i class="fa-solid fa-check-double"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Pending & Cancelled</p>
            <h3 class="stat-value">@ViewBag.PendingBookings</h3>
            <div class="stat-trend text-danger small">
                <i class="fa-solid fa-circle-xmark"></i>
                <span>@ViewBag.CancelledBookings Cancelled bookings</span>
            </div>
        </div>
        <div class="stat-icon bg-warning-subtle text-warning">
            <i class="fa-solid fa-spinner"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Total Revenue</p>
            <h3 class="stat-value">৳@(((decimal)ViewBag.TotalRevenue).ToString("N0"))</h3>
            <div class="stat-trend text-success small">
                <i class="fa-solid fa-circle-dollar-to-slot"></i>
                <span>Collected from paid bookings</span>
            </div>
        </div>
        <div class="stat-icon bg-info-subtle text-info">
            <i class="fa-solid fa-bangladeshi-taka-sign"></i>
        </div>
    </div>
</div>

<!-- Smart Features & Maintenance Summary -->
<h4 class="mt-4 mb-3 animate-fade-in delay-1 fw-bold"><i class="fa-solid fa-wrench text-primary me-2"></i>Smart Features & Maintenance</h4>
<div class="stats-grid animate-fade-in delay-1 mb-4">
    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Overdue Maintenance</p>
            <h3 class="stat-value text-danger">@ViewBag.OverdueMaintenanceCount</h3>
            <div class="stat-trend text-danger small">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>Vehicles requiring immediate service</span>
            </div>
        </div>
        <div class="stat-icon bg-danger-subtle text-danger">
            <i class="fa-solid fa-circle-exclamation"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Upcoming / In Progress</p>
            <h3 class="stat-value">@(ViewBag.UpcomingMaintenanceCount + ViewBag.InProgressMaintenanceCount)</h3>
            <div class="stat-trend text-info small">
                <i class="fa-solid fa-clock"></i>
                <span>@ViewBag.UpcomingMaintenanceCount Upcoming, @ViewBag.InProgressMaintenanceCount Active</span>
            </div>
        </div>
        <div class="stat-icon bg-info-subtle text-info">
            <i class="fa-solid fa-screwdriver-wrench"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Open Driver Issues</p>
            <h3 class="stat-value @(ViewBag.OpenDriverIssuesCount > 0 ? "text-warning" : "")">@ViewBag.OpenDriverIssuesCount</h3>
            <div class="stat-trend text-muted small">
                <i class="fa-solid fa-clipboard-list"></i>
                <span>Mechanical faults reported</span>
            </div>
        </div>
        <div class="stat-icon bg-warning-subtle text-warning">
            <i class="fa-solid fa-bullhorn"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">This Month Expenses</p>
            <h3 class="stat-value">৳@(((decimal)ViewBag.ThisMonthExpenses).ToString("N0"))</h3>
            <div class="stat-trend text-muted small">
                <i class="fa-solid fa-wallet"></i>
                <span>Total: ৳@(((decimal)ViewBag.TotalExpenses).ToString("N0"))</span>
            </div>
        </div>
        <div class="stat-icon bg-success-subtle text-success">
            <i class="fa-solid fa-wallet"></i>
        </div>
    </div>
</div>


<!-- Charts Row -->
<div class="row animate-fade-in delay-2 mb-4">
    <div class="col-lg-8 mb-4 mb-lg-0">
        <div class="card-modern h-100">
            <div class="card-header-modern">
                <h5 class="card-title-modern">Shipment Performance</h5>
                <div class="dropdown">
                    <button class="btn btn-sm btn-light border" data-bs-toggle="dropdown">
                        Last 7 Days <i class="fa-solid fa-chevron-down ms-1 x-small"></i>
                    </button>
                </div>
            </div>
            <div class="card-body-modern">
                <div id="shipment-chart" style="min-height: 350px;"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-modern h-100">
            <div class="card-header-modern">
                <h5 class="card-title-modern">Fleet Utilization</h5>
            </div>
            <div class="card-body-modern">
                <div id="utilization-chart" style="min-height: 350px;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Transactions & Vehicle Status -->
<div class="row animate-fade-in delay-3">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <h5 class="card-title-modern">Recent Shipment Status</h5>
                <a href="#" class="small text-primary text-decoration-none fw-bold">View All</a>
            </div>
            <div class="card-body-modern p-0">
                <div class="table-responsive">
                    <table class="table table-modern mb-0">
                        <thead>
                            <tr>
                                <th>Shipment ID</th>
                                <th>Vehicle</th>
                                <th>Driver</th>
                                <th>Destination</th>
                                <th>Status</th>
                                <th>ETA</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold text-primary">#SHP-9021</td>
                                <td>TRK-201 (Volvo FH)</td>
                                <td>James Wilson</td>
                                <td>Chicago, IL</td>
                                <td><span class="badge-status badge-success">On Route</span></td>
                                <td>Today, 4:30 PM</td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-primary">#SHP-9022</td>
                                <td>TRK-105 (Kenworth)</td>
                                <td>Sarah Miller</td>
                                <td>Austin, TX</td>
                                <td><span class="badge-status badge-info">Dispatched</span></td>
                                <td>Tomorrow, 9:00 AM</td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-primary">#SHP-9023</td>
                                <td>VAN-402 (Ford Transit)</td>
                                <td>Michael Chen</td>
                                <td>Seattle, WA</td>
                                <td><span class="badge-status badge-warning">Delayed</span></td>
                                <td>Today, 6:00 PM</td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-primary">#SHP-9024</td>
                                <td>TRK-310 (Freightliner)</td>
                                <td>Robert Taylor</td>
                                <td>Miami, FL</td>
                                <td><span class="badge-status badge-success">Completed</span></td>
                                <td>2 hours ago</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Shipment Chart
            var shipmentOptions = {
                series: [{
                    name: 'Delivered',
                    data: [31, 40, 28, 51, 42, 109, 100]
                }, {
                    name: 'Pending',
                    data: [11, 32, 45, 32, 34, 52, 41]
                }],
                chart: {
                    height: 350,
                    type: 'area',
                    toolbar: { show: false },
                    fontFamily: 'Inter, sans-serif'
                },
                colors: ['#6366f1', '#06b6d4'],
                dataLabels: { enabled: false },
                stroke: { curve: 'smooth', width: 3 },
                xaxis: {
                    categories: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
                    axisBorder: { show: false },
                    axisTicks: { show: false }
                },
                grid: {
                    borderColor: 'rgba(0,0,0,0.05)',
                    strokeDashArray: 4
                },
                legend: { position: 'top', horizontalAlign: 'right' }
            };

            var shipmentChart = new ApexCharts(document.querySelector("#shipment-chart"), shipmentOptions);
            shipmentChart.render();

            // Utilization Chart
            var utilOptions = {
                series: [76, 18, 6],
                chart: {
                    height: 350,
                    type: 'donut',
                    fontFamily: 'Inter, sans-serif'
                },
                labels: ['Active', 'In Maintenance', 'Idle'],
                colors: ['#10b981', '#f59e0b', '#ef4444'],
                legend: { position: 'bottom' },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '75%',
                            labels: {
                                show: true,
                                total: {
                                    show: true,
                                    label: 'Total Fleet',
                                    formatter: () => '124'
                                }
                            }
                        }
                    }
                }
            };

            var utilChart = new ApexCharts(document.querySelector("#utilization-chart"), utilOptions);
            utilChart.render();
        });
    </script>
}
