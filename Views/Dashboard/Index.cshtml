@model Transport_Management_System.Services.ExecutiveDashboardViewModel
@{
    ViewData["Title"] = "Executive Dashboard";
}

<div class="page-header animate-fade-in">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="page-title">Dashboard Overview</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-custom mb-0">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-primary">TMS PRO</a></li>
                    <li class="breadcrumb-item active">Dashboard</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Trips" asp-action="Create" class="btn btn-primary btn-modern shadow-sm">
                    <i class="fa-solid fa-plus me-2"></i> New Trip Dispatch
                </a>
            }
            else
            {
                <a asp-controller="Bookings" asp-action="Index" class="btn btn-primary btn-modern shadow-sm">
                    <i class="fa-solid fa-plus me-2"></i> Book a Ticket
                </a>
            }
        </div>
    </div>
</div>

<!-- KPI Widgets -->
<div class="stats-grid animate-fade-in delay-1">
    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Total Fleet Vehicles</p>
            <h3 class="stat-value">@Model.TotalVehicles</h3>
            <div class="stat-trend trend-up">
                <i class="fa-solid fa-truck"></i>
                <span>@ViewBag.ActiveVehiclesCount Active fleet vehicles</span>
            </div>
        </div>
        <div class="stat-icon bg-primary-subtle text-primary">
            <i class="fa-solid fa-truck"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Drivers Overview</p>
            <h3 class="stat-value">@Model.TotalDrivers</h3>
            <div class="stat-trend trend-up">
                <i class="fa-solid fa-user-check"></i>
                <span>@ViewBag.AvailableDrivers Available, @ViewBag.DriversOnTrip On Trip</span>
            </div>
            @if (ViewBag.ExpiredLicenses > 0 || ViewBag.ExpiringLicenses > 0)
            {
                <div class="mt-3 pt-2 border-top border-light d-flex flex-wrap gap-2 small fw-bold">
                    @if (ViewBag.ExpiredLicenses > 0)
                    {
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1"><i class="fa-solid fa-triangle-exclamation me-1"></i> @ViewBag.ExpiredLicenses Expired</span>
                    }
                    @if (ViewBag.ExpiringLicenses > 0)
                    {
                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1"><i class="fa-solid fa-clock me-1"></i> @ViewBag.ExpiringLicenses Expiring Soon</span>
                    }
                </div>
            }
        </div>
        <div class="stat-icon bg-success-subtle text-success">
            <i class="fa-solid fa-id-card"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Total Routes</p>
            <h3 class="stat-value">@Model.TotalRoutes</h3>
            <div class="stat-trend trend-up">
                <i class="fa-solid fa-route"></i>
                <span>@ViewBag.ActiveRoutes Active Routes</span>
            </div>
        </div>
        <div class="stat-icon bg-warning-subtle text-warning">
            <i class="fa-solid fa-route"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Total Stations</p>
            <h3 class="stat-value">@ViewBag.TotalStations</h3>
            <div class="stat-trend trend-up">
                <i class="fa-solid fa-location-dot"></i>
                <span>@ViewBag.ActiveStations Active Hubs</span>
            </div>
        </div>
        <div class="stat-icon bg-info-subtle text-info">
            <i class="fa-solid fa-location-dot"></i>
        </div>
    </div>
</div>

<!-- Trip Operations KPI Grid -->
<h4 class="mt-4 mb-3 animate-fade-in delay-1 fw-bold"><i class="fa-solid fa-calendar-days text-primary me-2"></i>Trip Operations Summary</h4>
<div class="stats-grid animate-fade-in delay-1 mb-4">
    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Total Trips</p>
            <h3 class="stat-value">@Model.TotalTrips</h3>
            <div class="stat-trend text-muted small">
                <i class="fa-solid fa-route"></i>
                <span>Overall dispatches</span>
            </div>
        </div>
        <div class="stat-icon bg-primary-subtle text-primary">
            <i class="fa-solid fa-calendar-days"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Scheduled & Ready</p>
            <h3 class="stat-value">@(ViewBag.ScheduledTrips + ViewBag.ReadyForDispatchTrips)</h3>
            <div class="stat-trend text-muted small">
                <i class="fa-solid fa-clock"></i>
                <span>@ViewBag.ScheduledTrips Scheduled, @ViewBag.ReadyForDispatchTrips Ready</span>
            </div>
        </div>
        <div class="stat-icon bg-info-subtle text-info">
            <i class="fa-solid fa-clock"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Ongoing Trips</p>
            <h3 class="stat-value text-primary">@ViewBag.OngoingTrips</h3>
            <div class="stat-trend text-warning small">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>@ViewBag.DelayedTrips Delayed Trips</span>
            </div>
        </div>
        <div class="stat-icon bg-warning-subtle text-warning">
            <i class="fa-solid fa-truck-fast"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Completed Trips</p>
            <h3 class="stat-value text-success">@ViewBag.CompletedTrips</h3>
            <div class="stat-trend text-danger small">
                <i class="fa-solid fa-circle-xmark"></i>
                <span>@ViewBag.CancelledTrips Cancelled Trips</span>
            </div>
        </div>
        <div class="stat-icon bg-success-subtle text-success">
            <i class="fa-solid fa-circle-check"></i>
        </div>
    </div>
</div>

<!-- Booking & Ticketing Summary -->
<h4 class="mt-4 mb-3 animate-fade-in delay-1 fw-bold"><i class="fa-solid fa-ticket text-primary me-2"></i>Booking & Ticketing Summary</h4>
<div class="stats-grid animate-fade-in delay-1 mb-4">
    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Total Bookings</p>
            <h3 class="stat-value">@Model.TotalBookings</h3>
            <div class="stat-trend text-muted small">
                <i class="fa-solid fa-receipt"></i>
                <span>Passenger reservations</span>
            </div>
        </div>
        <div class="stat-icon bg-primary-subtle text-primary">
            <i class="fa-solid fa-ticket"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Confirmed Bookings</p>
            <h3 class="stat-value">@ViewBag.ConfirmedBookings</h3>
            <div class="stat-trend text-success small">
                <i class="fa-solid fa-circle-check"></i>
                <span>Paid / Ready departures</span>
            </div>
        </div>
        <div class="stat-icon bg-success-subtle text-success">
            <i class="fa-solid fa-check-double"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Pending & Cancelled</p>
            <h3 class="stat-value">@ViewBag.PendingBookings</h3>
            <div class="stat-trend text-danger small">
                <i class="fa-solid fa-circle-xmark"></i>
                <span>@ViewBag.CancelledBookings Cancelled bookings</span>
            </div>
        </div>
        <div class="stat-icon bg-warning-subtle text-warning">
            <i class="fa-solid fa-spinner"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Total Revenue</p>
            <h3 class="stat-value">৳@Model.TotalRevenue.ToString("N0")</h3>
            <div class="stat-trend text-success small">
                <i class="fa-solid fa-circle-dollar-to-slot"></i>
                <span>Total booking collections</span>
            </div>
        </div>
        <div class="stat-icon bg-info-subtle text-info">
            <i class="fa-solid fa-bangladeshi-taka-sign"></i>
        </div>
    </div>
</div>

<!-- Smart Features & Maintenance Summary -->
<h4 class="mt-4 mb-3 animate-fade-in delay-1 fw-bold"><i class="fa-solid fa-wrench text-primary me-2"></i>Smart Features & Maintenance</h4>
<div class="stats-grid animate-fade-in delay-1 mb-4">
    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Overdue Maintenance</p>
            <h3 class="stat-value text-danger">@ViewBag.OverdueMaintenanceCount</h3>
            <div class="stat-trend text-danger small">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>Vehicles requiring immediate service</span>
            </div>
        </div>
        <div class="stat-icon bg-danger-subtle text-danger">
            <i class="fa-solid fa-circle-exclamation"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Upcoming / In Progress</p>
            <h3 class="stat-value">@(ViewBag.UpcomingMaintenanceCount + ViewBag.InProgressMaintenanceCount)</h3>
            <div class="stat-trend text-info small">
                <i class="fa-solid fa-clock"></i>
                <span>@ViewBag.UpcomingMaintenanceCount Upcoming, @ViewBag.InProgressMaintenanceCount Active</span>
            </div>
        </div>
        <div class="stat-icon bg-info-subtle text-info">
            <i class="fa-solid fa-screwdriver-wrench"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">Open Driver Issues</p>
            <h3 class="stat-value @(Model.OpenDriverIssuesCount > 0 ? "text-warning" : "")">@Model.OpenDriverIssuesCount</h3>
            <div class="stat-trend text-muted small">
                <i class="fa-solid fa-clipboard-list"></i>
                <span>Mechanical faults reported</span>
            </div>
        </div>
        <div class="stat-icon bg-warning-subtle text-warning">
            <i class="fa-solid fa-bullhorn"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <p class="stat-label">This Month Expenses</p>
            <h3 class="stat-value">৳@(((decimal)ViewBag.ThisMonthExpenses).ToString("N0"))</h3>
            <div class="stat-trend text-muted small">
                <i class="fa-solid fa-wallet"></i>
                <span>Total: ৳@Model.TotalExpenses.ToString("N0")</span>
            </div>
        </div>
        <div class="stat-icon bg-success-subtle text-success">
            <i class="fa-solid fa-wallet"></i>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row animate-fade-in delay-2 mb-4">
    <div class="col-lg-8 mb-4 mb-lg-0">
        <div class="card-modern h-100">
            <div class="card-header-modern">
                <h5 class="card-title-modern">Weekly Bookings & Income Trend</h5>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">Last 7 Days</span>
            </div>
            <div class="card-body-modern">
                <div id="shipment-chart" style="min-height: 350px;"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-modern h-100">
            <div class="card-header-modern">
                <h5 class="card-title-modern">Fleet Status Distribution</h5>
            </div>
            <div class="card-body-modern">
                <div id="utilization-chart" style="min-height: 350px;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Transactions & Operational Insights -->
<div class="row animate-fade-in delay-3 mb-4">
    <div class="col-lg-12">
        <div class="card-modern">
            <div class="card-header-modern border-bottom-0 pb-0">
                <h5 class="card-title-modern fw-bold"><i class="fa-solid fa-receipt text-primary me-2"></i>Real-time Operations & Insights</h5>
            </div>
            <div class="card-body-modern pt-2">
                <!-- Navigation Tabs -->
                <ul class="nav nav-tabs nav-tabs-modern mb-3" id="recentActivityTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="bookings-tab" data-bs-toggle="tab" data-bs-target="#bookings-panel" type="button" role="tab" aria-controls="bookings-panel" aria-selected="true">
                            <i class="fa-solid fa-ticket me-2"></i>Recent Bookings
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="trips-tab" data-bs-toggle="tab" data-bs-target="#trips-panel" type="button" role="tab" aria-controls="trips-panel" aria-selected="false">
                            <i class="fa-solid fa-calendar-day me-2"></i>Trips & Dispatches
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="maintenance-tab" data-bs-toggle="tab" data-bs-target="#maintenance-panel" type="button" role="tab" aria-controls="maintenance-panel" aria-selected="false">
                            <i class="fa-solid fa-screwdriver-wrench me-2"></i>Maintenance Activities
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="driverReports-tab" data-bs-toggle="tab" data-bs-target="#driverReports-panel" type="button" role="tab" aria-controls="driverReports-panel" aria-selected="false">
                            <i class="fa-solid fa-clipboard-list me-2"></i>Driver Issue Logs
                        </button>
                    </li>
                </ul>

                <!-- Tab Panels -->
                <div class="tab-content" id="recentActivityTabsContent">
                    <!-- Bookings Panel -->
                    <div class="tab-pane fade show active" id="bookings-panel" role="tabpanel" aria-labelledby="bookings-tab">
                        <div class="table-responsive">
                            <table class="table table-modern align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Passenger</th>
                                        <th>Trip Name</th>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>Payment</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.RecentBookings.Any())
                                    {
                                        foreach (var booking in Model.RecentBookings)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">#@booking.BookingReference</td>
                                                <td>@booking.User?.UserName</td>
                                                <td>@booking.Trip?.TripName</td>
                                                <td>@booking.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td class="fw-semibold">৳@booking.TotalAmount.ToString("N2")</td>
                                                <td>
                                                    <span class="badge @(booking.PaymentStatus == PaymentStatus.Paid ? "bg-success" : booking.PaymentStatus == PaymentStatus.Pending ? "bg-warning" : "bg-danger") bg-opacity-10 text-@(booking.PaymentStatus == PaymentStatus.Paid ? "success" : booking.PaymentStatus == PaymentStatus.Pending ? "warning" : "danger") border border-@(booking.PaymentStatus == PaymentStatus.Paid ? "success" : booking.PaymentStatus == PaymentStatus.Pending ? "warning" : "danger") border-opacity-25 px-2 py-1">
                                                        @booking.PaymentStatus
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge @(booking.Status == BookingStatus.Confirmed ? "bg-success" : booking.Status == BookingStatus.Pending ? "bg-warning" : "bg-danger") bg-opacity-10 text-@(booking.Status == BookingStatus.Confirmed ? "success" : booking.Status == BookingStatus.Pending ? "warning" : "danger") border border-@(booking.Status == BookingStatus.Confirmed ? "success" : booking.Status == BookingStatus.Pending ? "warning" : "danger") border-opacity-25 px-2 py-1">
                                                        @booking.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted">No recent bookings recorded.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Trips & Dispatches Panel -->
                    <div class="tab-pane fade" id="trips-panel" role="tabpanel" aria-labelledby="trips-tab">
                        <div class="table-responsive">
                            <table class="table table-modern align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Trip Name</th>
                                        <th>Route</th>
                                        <th>Vehicle</th>
                                        <th>Driver</th>
                                        <th>Departure</th>
                                        <th>Tickets Price</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.RecentTrips.Any())
                                    {
                                        foreach (var trip in Model.RecentTrips)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">@trip.TripName</td>
                                                <td>@trip.Route?.RouteName</td>
                                                <td>@trip.Vehicle?.VehicleName (@trip.Vehicle?.VehicleNumber)</td>
                                                <td>@trip.Driver?.FullName</td>
                                                <td>@trip.DepartureDate.ToString("yyyy-MM-dd") @trip.DepartureTime.ToString(@"hh\:mm")</td>
                                                <td class="fw-semibold">৳@trip.TicketPrice.ToString("N2")</td>
                                                <td>
                                                    <span class="badge @(trip.Status == TripStatus.Completed ? "bg-success" : trip.Status == TripStatus.Scheduled ? "bg-info" : trip.Status == TripStatus.Ongoing ? "bg-primary" : "bg-warning") bg-opacity-10 text-@(trip.Status == TripStatus.Completed ? "success" : trip.Status == TripStatus.Scheduled ? "info" : trip.Status == TripStatus.Ongoing ? "primary" : "warning") border border-@(trip.Status == TripStatus.Completed ? "success" : trip.Status == TripStatus.Scheduled ? "info" : trip.Status == TripStatus.Ongoing ? "primary" : "warning") border-opacity-25 px-2 py-1">
                                                        @trip.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted">No recent trips found.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Maintenance Activities Panel -->
                    <div class="tab-pane fade" id="maintenance-panel" role="tabpanel" aria-labelledby="maintenance-tab">
                        <div class="table-responsive">
                            <table class="table table-modern align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Vehicle</th>
                                        <th>Type</th>
                                        <th>Provider</th>
                                        <th>Service Date</th>
                                        <th>Cost</th>
                                        <th>Next Service</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.RecentMaintenanceActivities.Any())
                                    {
                                        foreach (var maint in Model.RecentMaintenanceActivities)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">@maint.Vehicle?.VehicleName</td>
                                                <td>@maint.MaintenanceType</td>
                                                <td>@maint.ServiceProvider</td>
                                                <td>@maint.ServiceDate.ToString("yyyy-MM-dd")</td>
                                                <td class="fw-semibold">৳@maint.Cost.ToString("N2")</td>
                                                <td>@maint.NextServiceDate.ToString("yyyy-MM-dd")</td>
                                                <td>
                                                    <span class="badge @(maint.Status == MaintenanceStatus.Completed ? "bg-success" : maint.Status == MaintenanceStatus.InProgress ? "bg-warning" : "bg-info") bg-opacity-10 text-@(maint.Status == MaintenanceStatus.Completed ? "success" : maint.Status == MaintenanceStatus.InProgress ? "warning" : "info") border border-@(maint.Status == MaintenanceStatus.Completed ? "success" : maint.Status == MaintenanceStatus.InProgress ? "warning" : "info") border-opacity-25 px-2 py-1">
                                                        @maint.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted">No recent maintenance records found.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Driver Issue Logs Panel -->
                    <div class="tab-pane fade" id="driverReports-panel" role="tabpanel" aria-labelledby="driverReports-tab">
                        <div class="table-responsive">
                            <table class="table table-modern align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Driver</th>
                                        <th>Vehicle</th>
                                        <th>Issue Category</th>
                                        <th>Severity</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.RecentDriverReports.Any())
                                    {
                                        foreach (var issue in Model.RecentDriverReports)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">@issue.Driver?.FullName</td>
                                                <td>@issue.Vehicle?.VehicleName</td>
                                                <td>@issue.IssueCategory</td>
                                                <td>
                                                    <span class="badge @(issue.Priority == IssuePriority.High || issue.Priority == IssuePriority.Critical ? "bg-danger" : "bg-warning") bg-opacity-10 text-@(issue.Priority == IssuePriority.High || issue.Priority == IssuePriority.Critical ? "danger" : "warning") border border-@(issue.Priority == IssuePriority.High || issue.Priority == IssuePriority.Critical ? "danger" : "warning") border-opacity-25 px-2 py-1">
                                                        @issue.Priority
                                                    </span>
                                                </td>
                                                <td>@issue.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>
                                                    <span class="badge @(issue.Status == IssueStatus.Resolved ? "bg-success" : issue.Status == IssueStatus.Open ? "bg-danger" : "bg-warning") bg-opacity-10 text-@(issue.Status == IssueStatus.Resolved ? "success" : issue.Status == IssueStatus.Open ? "danger" : "warning") border border-@(issue.Status == IssueStatus.Resolved ? "success" : issue.Status == IssueStatus.Open ? "danger" : "warning") border-opacity-25 px-2 py-1">
                                                        @issue.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">No recent driver issues reported.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Weekly Bookings & Income Trend Area/Line Chart
            var labels = @Html.Raw(Json.Serialize(ViewBag.ChartLabels));
            var bookingsData = @Html.Raw(Json.Serialize(ViewBag.ChartBookings));
            var revenuesData = @Html.Raw(Json.Serialize(ViewBag.ChartRevenues));

            var shipmentOptions = {
                series: [{
                    name: 'Bookings (Count)',
                    type: 'column',
                    data: bookingsData
                }, {
                    name: 'Income (BDT)',
                    type: 'area',
                    data: revenuesData
                }],
                chart: {
                    height: 350,
                    type: 'line',
                    stacked: false,
                    toolbar: { show: false },
                    fontFamily: 'Inter, sans-serif'
                },
                colors: ['#06b6d4', '#6366f1'],
                stroke: { width: [0, 3], curve: 'smooth' },
                fill: {
                    opacity: [0.85, 0.25],
                    gradient: {
                        inverseColors: false,
                        shade: 'light',
                        type: "vertical",
                        opacityFrom: 0.85,
                        opacityTo: 0.55
                    }
                },
                dataLabels: { enabled: false },
                xaxis: {
                    categories: labels,
                    axisBorder: { show: false },
                    axisTicks: { show: false }
                },
                yaxis: [
                    {
                        title: { text: "Bookings Count", style: { color: '#06b6d4' } },
                        labels: { style: { colors: '#06b6d4' } }
                    },
                    {
                        opposite: true,
                        title: { text: "Revenue (BDT)", style: { color: '#6366f1' } },
                        labels: {
                            style: { colors: '#6366f1' },
                            formatter: function (value) { return "৳" + value.toLocaleString(); }
                        }
                    }
                ],
                grid: {
                    borderColor: 'rgba(0,0,0,0.05)',
                    strokeDashArray: 4
                },
                legend: { position: 'top', horizontalAlign: 'right' }
            };

            var shipmentChart = new ApexCharts(document.querySelector("#shipment-chart"), shipmentOptions);
            shipmentChart.render();

            // Utilization / Fleet Status Donut Chart
            var activeCount = @ViewBag.ActiveVehiclesCount;
            var maintCount = @ViewBag.MaintenanceVehiclesCount;
            var outCount = @ViewBag.OutOfServiceVehiclesCount;

            var utilOptions = {
                series: [activeCount, maintCount, outCount],
                chart: {
                    height: 350,
                    type: 'donut',
                    fontFamily: 'Inter, sans-serif'
                },
                labels: ['Active', 'In Maintenance', 'Out Of Service'],
                colors: ['#10b981', '#f59e0b', '#ef4444'],
                legend: { position: 'bottom' },
                plotOptions: {
                    pie: {
                        donut: {
                            size: '75%',
                            labels: {
                                show: true,
                                total: {
                                    show: true,
                                    label: 'Total Fleet',
                                    formatter: () => '@ViewBag.TotalVehiclesCount'
                                }
                            }
                        }
                    }
                }
            };

            var utilChart = new ApexCharts(document.querySelector("#utilization-chart"), utilOptions);
            utilChart.render();
        });
    </script>
}
