@model Transport_Management_System.Models.ViewModels.BookingConfirmViewModel

@{
    ViewData["Title"] = "Confirm Your Booking";
    var seats     = Model.SeatList;
    var seatCount = seats.Count;
    var unitPrice = Model.Trip?.TicketPrice ?? 0;
    var total     = unitPrice * seatCount;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-10">
            <div class="d-flex align-items-center gap-3 mb-4">
                <a asp-controller="Bookings" asp-action="SelectSeat" asp-route-id="@Model.TripId"
                   class="btn btn-outline-secondary rounded-circle p-2 d-flex align-items-center justify-content-center"
                   style="width:40px;height:40px;">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="h3 fw-bold mb-1">Confirm Booking</h1>
                    <p class="text-muted small mb-0">Review your booking details before confirming.</p>
                </div>
            </div>

            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning rounded-4 mb-4 alert-dismissible fade show">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["WarningMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Booking Summary Card -->
            <div class="card border-0 shadow rounded-4 mb-4 overflow-hidden">
                <!-- Header -->
                <div class="text-white p-4" style="background: linear-gradient(135deg, #4f46e5, #0ea5e9);">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fa-solid fa-ticket-simple fs-3 mb-2 d-block opacity-75"></i>
                            <h4 class="fw-bold mb-0">Booking Summary</h4>
                        </div>
                        <div class="text-end">
                            @if (seatCount == 1)
                            {
                                <div class="fs-1 fw-bold font-monospace">@seats[0]</div>
                                <small class="opacity-75">Your Seat</small>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap gap-2 justify-content-end mb-1">
                                    @foreach (var s in seats)
                                    {
                                        <span class="badge bg-white text-primary fw-bold fs-6 px-3 py-2 rounded-3">@s</span>
                                    }
                                </div>
                                <small class="opacity-75">@seatCount Seats Selected</small>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Route Visualization -->
                    <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 mb-4">
                        <div class="text-center">
                            <div class="fw-bold">@Model.Trip?.Route?.OriginStation?.StationName</div>
                            <small class="text-muted">@Model.Trip?.Route?.OriginStation?.City</small>
                        </div>
                        <div class="text-center flex-grow-1 mx-3">
                            <i class="fa-solid fa-arrow-right-long text-primary fs-4"></i>
                            <div class="text-muted small">@Model.Trip?.Route?.DistanceKm km</div>
                        </div>
                        <div class="text-center">
                            <div class="fw-bold">@Model.Trip?.Route?.DestinationStation?.StationName</div>
                            <small class="text-muted">@Model.Trip?.Route?.DestinationStation?.City</small>
                        </div>
                    </div>

                    <!-- Details Grid -->
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <span class="text-muted small d-block">PASSENGER</span>
                                <strong class="d-block">@Model.PassengerName</strong>
                                <small class="text-muted">@Model.PassengerEmail</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <span class="text-muted small d-block">TRIP</span>
                                <strong class="d-block">@Model.Trip?.TripName</strong>
                                <small class="text-muted">#TRP-@Model.TripId</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block">DATE</span>
                                <strong class="small">@Model.Trip?.DepartureDate.ToString("MMM dd, yyyy")</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block">DEPARTS</span>
                                <strong class="small">@(Model.Trip != null ? DateTime.Today.Add(Model.Trip.DepartureTime).ToString("hh:mm tt") : "-")</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block">VEHICLE</span>
                                <strong class="small">@Model.Trip?.Vehicle?.VehicleNumber</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Seats Summary (multi-seat) -->
                    @if (seatCount > 1)
                    {
                        <div class="p-3 border border-primary border-opacity-25 rounded-3 mb-4 bg-primary bg-opacity-10">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-primary small"><i class="fa-solid fa-couch me-2"></i>Selected Seats</span>
                                <span class="badge bg-primary rounded-pill">@seatCount seats</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var s in seats)
                                {
                                    <span class="badge bg-white border border-primary text-primary fw-bold px-3 py-2 rounded-3 fs-6">@s</span>
                                }
                            </div>
                        </div>
                    }

                    <!-- Price Breakdown -->
                    <div class="border rounded-3 mb-4 overflow-hidden">
                        @if (seatCount > 1)
                        {
                            <div class="d-flex justify-content-between px-3 py-2 bg-light border-bottom">
                                <span class="text-muted small">Price per seat</span>
                                <span class="fw-semibold small">@(unitPrice > 0 ? $"৳{unitPrice:N0}" : "FREE")</span>
                            </div>
                            <div class="d-flex justify-content-between px-3 py-2 bg-light border-bottom">
                                <span class="text-muted small">Number of seats</span>
                                <span class="fw-semibold small">× @seatCount</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between align-items-center p-3">
                            <span class="fw-bold text-dark">Total Amount</span>
                            <span class="fs-4 fw-bold text-success">
                                @(total > 0 ? $"৳{total:N0}" : "FREE")
                            </span>
                        </div>
                    </div>

                    <!-- Confirm Form -->
                    <form asp-action="Confirm" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TripId"      value="@Model.TripId" />
                        <input type="hidden" name="SeatNumbers" value="@Model.SeatNumbers" />

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Remarks / Special Requests (Optional)</label>
                            <textarea name="Remarks" class="form-control form-control-modern" rows="2"
                                      placeholder="Any special requests or notes..."></textarea>
                        </div>

                        <div class="d-flex gap-3">
                            <a asp-action="SelectSeat" asp-route-id="@Model.TripId"
                               class="btn btn-light border flex-grow-1 py-3 rounded-3 fw-bold">
                                Back
                            </a>
                            <button type="submit" id="confirmBtn"
                                    class="btn btn-success flex-grow-1 py-3 rounded-3 fw-bold shadow-sm">
                                <i class="fa-solid fa-circle-check me-2"></i>
                                Confirm @(seatCount > 1 ? $"{seatCount} Seats" : "Booking")
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <p class="text-center text-muted small">
                <i class="fa-solid fa-shield-halved me-1"></i>
                Your booking is secure. Payment is collected on departure.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Prevent double submit
        document.getElementById('confirmBtn').addEventListener('click', function () {
            this.disabled = true;
            this.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Processing...';
            this.closest('form').submit();
        });
    </script>
}
