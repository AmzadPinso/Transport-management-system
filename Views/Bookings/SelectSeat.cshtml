@model Transport_Management_System.Models.ViewModels.BookingSeatViewModel

@{
    ViewData["Title"] = "Select Your Seat";
}

<div class="container py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-controller="Bookings" asp-action="Index" class="btn btn-outline-secondary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <div>
            <h1 class="h3 fw-bold mb-1">Choose Your Seat</h1>
            <p class="text-muted small mb-0">@Model.Trip.TripName — @Model.Trip.Route?.RouteName</p>
        </div>
    </div>

    <!-- Passenger Count Selection for Group Recommendations -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span class="small fw-semibold text-muted"><i class="fa-solid fa-users me-2"></i>Traveling with a group? Adjust passenger count to find adjacent seats:</span>
            <form method="get" class="d-flex align-items-center gap-2 mb-0">
                <select name="passengerCount" class="form-select form-select-sm rounded-3" style="width: 100px;" onchange="this.form.submit()">
                    @for (int count = 1; count <= 4; count++)
                    {
                        if (ViewBag.PassengerCount == count)
                        {
                            <option value="@count" selected>@count pax</option>
                        }
                        else
                        {
                            <option value="@count">@count pax</option>
                        }
                    }
                </select>
            </form>
        </div>
    </div>

    <!-- Smart Seat Recommendation Banner -->
    @if (ViewBag.Recommendation != null)
    {
        var rec = (Transport_Management_System.Services.SeatRecommendation)ViewBag.Recommendation;
        if (rec.SuggestedSeats.Any())
        {
            <div class="card border-0 bg-primary bg-opacity-10 text-primary-emphasis mb-4 shadow-sm rounded-4 animate-fade-in">
                <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary text-white rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fa-solid fa-wand-magic-sparkles fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1 text-dark">AI Seat Recommendation (@(rec.IsWindow ? "Window Priority" : "Adjacent Group"))</h6>
                            <p class="mb-0 text-muted small">@rec.Message</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @foreach (var seatNum in rec.SuggestedSeats)
                        {
                            <button type="button" class="btn btn-primary btn-sm fw-bold px-3 py-2 rounded-3" 
                                    onclick="applyRecommendedSeat('@seatNum')">
                                Select Seat @seatNum
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Seat Map -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <!-- Legend -->
                    <div class="d-flex gap-4 mb-4 flex-wrap">
                        <div class="d-flex align-items-center gap-2">
                            <div class="seat-demo available"></div>
                            <span class="small text-muted fw-semibold">Available</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="seat-demo booked"></div>
                            <span class="small text-muted fw-semibold">Booked</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="seat-demo selected"></div>
                            <span class="small text-muted fw-semibold">Your Selection</span>
                        </div>
                    </div>

                    <!-- Bus Front Indicator -->
                    <div class="text-center mb-4">
                        <div class="bus-front d-inline-block px-5 py-2 rounded-pill bg-dark text-white small fw-bold">
                            <i class="fa-solid fa-steering-wheel me-2"></i>DRIVER
                        </div>
                    </div>

                    <!-- Seat Grid -->
                    <form id="seatForm" asp-controller="Bookings" asp-action="Confirm" method="get">
                        <input type="hidden" name="tripId" value="@Model.Trip.TripId" />
                        <input type="hidden" name="seatNumber" id="selectedSeatInput" value="" />

                        <div class="seat-bus-container mx-auto" style="max-width: 420px;">
                            @foreach (var row in Model.SeatLayout)
                            {
                                <div class="seat-row d-flex justify-content-center gap-2 mb-3">
                                    @for (int i = 0; i < row.Count; i++)
                                    {
                                        var seat = row[i];
                                        // Insert aisle gap after seat 2
                                        if (i == 2)
                                        {
                                            <div style="width:24px;"></div>
                                        }

                                        if (seat.IsBooked)
                                        {
                                            <div class="seat booked" title="Booked - @seat.SeatNumber">
                                                <i class="fa-solid fa-user"></i>
                                                <span>@seat.SeatNumber</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="seat available" data-seat="@seat.SeatNumber"
                                                 title="Available - @seat.SeatNumber"
                                                 onclick="selectSeat(this)">
                                                <i class="fa-regular fa-square"></i>
                                                <span>@seat.SeatNumber</span>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>

                        <div id="seatSelectedMsg" class="alert alert-success rounded-3 mt-4 d-none text-center fw-bold">
                            <i class="fa-solid fa-couch me-2"></i>Seat <span id="chosenSeatDisplay"></span> selected!
                        </div>

                        <div class="d-flex gap-3 justify-content-end mt-4">
                            <a asp-controller="Bookings" asp-action="Index" class="btn btn-light border rounded-3 px-4">Cancel</a>
                            <button type="submit" id="proceedBtn" class="btn-modern btn-modern-primary px-5 rounded-3" disabled>
                                <i class="fa-solid fa-arrow-right me-2"></i>Proceed to Confirm
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Trip Summary Sidebar -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 text-secondary small text-uppercase">Trip Summary</h5>
                    <div class="mb-3">
                        <span class="text-muted small d-block">Route</span>
                        <strong>@Model.Trip.Route?.RouteName</strong>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <span class="text-muted small d-block">From</span>
                            <strong class="small">@Model.Trip.Route?.OriginStation?.StationName</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block">To</span>
                            <strong class="small">@Model.Trip.Route?.DestinationStation?.StationName</strong>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <span class="text-muted small d-block">Date</span>
                            <strong class="small">@Model.Trip.DepartureDate.ToString("MMM dd, yyyy")</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block">Departs</span>
                            <strong class="small">@DateTime.Today.Add(Model.Trip.DepartureTime).ToString("hh:mm tt")</strong>
                        </div>
                    </div>
                    <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Ticket Price</span>
                        <strong class="text-success fs-5">
                            @(Model.Trip.TicketPrice > 0 ? $"৳{Model.Trip.TicketPrice:N0}" : "FREE")
                        </strong>
                    </div>
                </div>
            </div>

            <!-- Availability Counter -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 text-secondary small text-uppercase">Availability</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Available Seats</span>
                        <span class="fw-bold text-success">@Model.TotalAvailable</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted small">Booked Seats</span>
                        <span class="fw-bold text-danger">@Model.TotalBooked</span>
                    </div>
                    <div class="progress rounded-pill" style="height: 8px;">
                        @{ var pct = Model.TotalBooked + Model.TotalAvailable > 0
                               ? (int)((double)Model.TotalBooked / (Model.TotalBooked + Model.TotalAvailable) * 100)
                               : 0; }
                        <div class="progress-bar bg-danger" role="progressbar" style="width:@pct%"></div>
                    </div>
                    <small class="text-muted">@pct% occupied</small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .seat {
        width: 56px; height: 56px;
        border-radius: 10px;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        font-size: .65rem; font-weight: 700;
        cursor: pointer; transition: all .18s ease;
        user-select: none;
        border: 2px solid transparent;
    }
    .seat i { font-size: 1rem; margin-bottom: 2px; }
    .seat.available {
        background: rgba(16,185,129,.1);
        color: #059669;
        border-color: rgba(16,185,129,.3);
    }
    .seat.available:hover {
        background: #10b981;
        color: white;
        transform: scale(1.1);
        box-shadow: 0 4px 15px rgba(16,185,129,.4);
    }
    .seat.booked {
        background: rgba(239,68,68,.08);
        color: #dc2626;
        border-color: rgba(239,68,68,.2);
        cursor: not-allowed;
        opacity: .75;
    }
    .seat.selected {
        background: var(--primary);
        color: white;
        border-color: var(--primary-hover);
        box-shadow: 0 4px 15px rgba(79,70,229,.4);
        transform: scale(1.08);
    }
    .seat-demo {
        width: 24px; height: 24px; border-radius: 6px; border: 2px solid transparent;
    }
    .seat-demo.available { background: rgba(16,185,129,.15); border-color: rgba(16,185,129,.4); }
    .seat-demo.booked    { background: rgba(239,68,68,.1);   border-color: rgba(239,68,68,.3); }
    .seat-demo.selected  { background: var(--primary);        border-color: var(--primary-hover); }
</style>

@section Scripts {
    <script>
        let currentSeat = null;

        function selectSeat(el) {
            if (el.classList.contains('booked')) return;

            // Deselect previous
            if (currentSeat) {
                currentSeat.classList.remove('selected');
                currentSeat.classList.add('available');
                currentSeat.querySelector('i').className = 'fa-regular fa-square';
            }

            // Select new
            el.classList.remove('available');
            el.classList.add('selected');
            el.querySelector('i').className = 'fa-solid fa-couch';
            currentSeat = el;

            const seatNum = el.dataset.seat;
            document.getElementById('selectedSeatInput').value = seatNum;
            document.getElementById('chosenSeatDisplay').textContent = seatNum;
            document.getElementById('seatSelectedMsg').classList.remove('d-none');
            document.getElementById('proceedBtn').disabled = false;
        }

        function applyRecommendedSeat(seatNum) {
            const el = document.querySelector(`[data-seat="${seatNum}"]`);
            if (el) {
                selectSeat(el);
            }
        }
    </script>
}
