<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TMS PRO</title>
    
    <!-- CSS Bundles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Icon Sets -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- Custom Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Transport_Management_System.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-container">
        <!-- Sidebar Navigation -->
        @await Html.PartialAsync("_Sidebar")

        <!-- Main Application Area -->
        <div class="main-content">
            <!-- Sticky Topbar -->
            @await Html.PartialAsync("_Topbar")

            <!-- Dynamic Content Wrapper -->
            <main role="main" class="content-wrapper">
                @RenderBody()
            </main>

            <!-- Footer Section -->
            <footer class="p-4 border-top mt-auto bg-card">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">&copy; 2026 - <span class="text-primary fw-bold">TMS PRO</span>. Enterprise Logistics Platform.</span>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-muted text-decoration-none small">Support</a>
                        <a href="#" class="text-muted text-decoration-none small">Privacy</a>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Charting & Interactivity -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    
    <!-- Application Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
