@model Transport_Management_System.Models.Route

@{
    ViewData["Title"] = $"Manage Points: {Model.RouteName}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Routes</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.RouteId" class="text-decoration-none">Route Details</a></li>
                    <li class="breadcrumb-item active text-white">Manage Pickup & Drop-Off Points</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-0">Manage Pickup & Drop-Off Points</h1>
            <p class="text-muted small">Route: <strong>@Model.RouteName</strong> (@Model.OriginStation?.StationName → @Model.DestinationStation?.StationName)</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.RouteId" class="btn btn-outline-light rounded-3">
            <i class="fa-solid fa-arrow-left me-2"></i>Back to Details
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Add Point Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 bg-dark-subtle mb-4">
                <div class="card-header bg-transparent border-bottom border-secondary py-3">
                    <h5 class="fw-bold text-light mb-0"><i class="fa-solid fa-plus text-primary me-2"></i>Add Point</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="AddPoint" method="post">
                        <input type="hidden" name="routeId" value="@Model.RouteId" />

                        <div class="form-group mb-3">
                            <label class="form-label text-muted small fw-bold mb-1">Select Station</label>
                            <select name="stationId" class="form-select border-0 bg-light py-2" asp-items="ViewBag.RouteStations" required>
                                <option value="">-- Choose Station --</option>
                            </select>
                            <div class="form-text text-muted x-small">Only stations part of this route can have points.</div>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label text-muted small fw-bold mb-1">Point Type</label>
                            <select name="pointType" class="form-select border-0 bg-light py-2" required>
                                <option value="pickup">Pickup Point</option>
                                <option value="dropoff">Drop-Off Point</option>
                            </select>
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label text-muted small fw-bold mb-1">Point Name/Location</label>
                            <input name="pointName" type="text" class="form-control border-0 bg-light py-2" placeholder="e.g. GEC Circle, AK Khan" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-bold">
                            <i class="fa-solid fa-circle-plus me-2"></i>Add Point
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Current Points Lists -->
        <div class="col-lg-8">
            <div class="row g-4">
                <!-- Pickup Points List -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 bg-dark-subtle">
                        <div class="card-header bg-transparent border-bottom border-secondary py-3">
                            <h5 class="fw-bold text-success mb-0"><i class="fa-solid fa-circle-arrow-up me-2"></i>Pickup Points</h5>
                        </div>
                        <div class="card-body p-4">
                            @if (!Model.PickupPoints.Any())
                            {
                                <p class="text-muted small mb-0 fst-italic">No pickup points added yet.</p>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var point in Model.PickupPoints.OrderBy(p => p.StationId))
                                    {
                                        <div class="list-group-item bg-transparent border-bottom border-secondary px-0 py-2 d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="fw-bold text-light">@point.PointName</div>
                                                <div class="x-small text-muted">@point.Station?.StationName</div>
                                            </div>
                                            <form asp-action="RemovePoint" method="post" class="d-inline">
                                                <input type="hidden" name="pointId" value="@point.PickupPointId" />
                                                <input type="hidden" name="pointType" value="pickup" />
                                                <input type="hidden" name="routeId" value="@Model.RouteId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-1" title="Remove Point" onclick="return confirm('Remove this point?')">
                                                    <i class="fa-solid fa-trash-can small"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Dropoff Points List -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 bg-dark-subtle">
                        <div class="card-header bg-transparent border-bottom border-secondary py-3">
                            <h5 class="fw-bold text-info mb-0"><i class="fa-solid fa-circle-arrow-down me-2"></i>Drop-Off Points</h5>
                        </div>
                        <div class="card-body p-4">
                            @if (!Model.DropOffPoints.Any())
                            {
                                <p class="text-muted small mb-0 fst-italic">No drop-off points added yet.</p>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var point in Model.DropOffPoints.OrderBy(p => p.StationId))
                                    {
                                        <div class="list-group-item bg-transparent border-bottom border-secondary px-0 py-2 d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="fw-bold text-light">@point.PointName</div>
                                                <div class="x-small text-muted">@point.Station?.StationName</div>
                                            </div>
                                            <form asp-action="RemovePoint" method="post" class="d-inline">
                                                <input type="hidden" name="pointId" value="@point.DropOffPointId" />
                                                <input type="hidden" name="pointType" value="dropoff" />
                                                <input type="hidden" name="routeId" value="@Model.RouteId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-1" title="Remove Point" onclick="return confirm('Remove this point?')">
                                                    <i class="fa-solid fa-trash-can small"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
