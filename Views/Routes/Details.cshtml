@model Transport_Management_System.Models.Route
@using Transport_Management_System.Models

@{
    ViewData["Title"] = $"Route: {Model.RouteName}";
    int hrs = Model.EstimatedDurationMinutes / 60;
    int mins = Model.EstimatedDurationMinutes % 60;
    string durationStr = hrs > 0 ? $"{hrs}h {mins}m" : $"{mins}m";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Routes</a></li>
                    <li class="breadcrumb-item active text-white">Route Details</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-0">Route: @Model.RouteName</h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ManageStops" asp-route-id="@Model.RouteId" class="btn btn-warning rounded-3">
                <i class="fa-solid fa-list-ol me-2"></i>Manage Stops
            </a>
            <a asp-action="ManagePoints" asp-route-id="@Model.RouteId" class="btn btn-info rounded-3 text-dark">
                <i class="fa-solid fa-location-crosshairs me-2"></i>Manage Points
            </a>
            <a asp-action="Edit" asp-route-id="@Model.RouteId" class="btn btn-primary rounded-3">
                <i class="fa-solid fa-pen-to-square me-2"></i>Edit Route
            </a>
        </div>
    </div>

    <!-- Quick Stats Grid -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-dark p-3 text-center">
                <p class="text-muted small mb-1">Total Distance</p>
                <h3 class="fw-bold text-primary mb-0">@Model.DistanceKm km</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-dark p-3 text-center">
                <p class="text-muted small mb-1">Est. Duration</p>
                <h3 class="fw-bold text-success mb-0">@durationStr</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-dark p-3 text-center">
                <p class="text-muted small mb-1">Status</p>
                <h3 class="fw-bold mb-0 text-info">@Model.Status</h3>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Visual Stepper Timeline Column -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-dark-subtle">
                <div class="card-header bg-transparent border-bottom border-secondary py-3">
                    <h5 class="fw-bold text-light mb-0"><i class="fa-solid fa-route text-primary me-2"></i>Transit Flow Timeline</h5>
                </div>
                <div class="card-body p-4">
                    <div class="timeline">
                        <!-- Origin Station -->
                        <div class="timeline-item d-flex gap-4 pb-4">
                            <div class="timeline-marker text-center">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; border: 4px solid var(--bs-dark)">
                                    O
                                </div>
                                <div class="timeline-line bg-secondary mx-auto" style="width: 2px; height: calc(100% - 20px);"></div>
                            </div>
                            <div class="timeline-content">
                                <h6 class="fw-bold text-light mb-0">@Model.OriginStation?.StationName (Origin)</h6>
                                <p class="small text-muted mb-0">@Model.OriginStation?.Address, @Model.OriginStation?.City</p>
                            </div>
                        </div>

                        <!-- Intermediate Stops in Order -->
                        @{
                            var orderedStops = Model.IntermediateStops.OrderBy(s => s.SequenceOrder).ToList();
                        }
                        @for (int i = 0; i < orderedStops.Count; i++)
                        {
                            var stop = orderedStops[i];
                            <div class="timeline-item d-flex gap-4 pb-4">
                                <div class="timeline-marker text-center">
                                    <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold small" style="width: 40px; height: 40px; border: 4px solid var(--bs-dark)">
                                        @(i + 1)
                                    </div>
                                    <div class="timeline-line bg-secondary mx-auto" style="width: 2px; height: calc(100% - 20px);"></div>
                                </div>
                                <div class="timeline-content">
                                    <h6 class="fw-bold text-light mb-0">@stop.Station?.StationName</h6>
                                    <p class="small text-muted mb-0">Stop #@(i + 1) — @stop.Station?.Address, @stop.Station?.City</p>
                                </div>
                            </div>
                        }

                        <!-- Destination Station -->
                        <div class="timeline-item d-flex gap-4">
                            <div class="timeline-marker text-center">
                                <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; border: 4px solid var(--bs-dark)">
                                    D
                                </div>
                            </div>
                            <div class="timeline-content">
                                <h6 class="fw-bold text-light mb-0">@Model.DestinationStation?.StationName (Destination)</h6>
                                <p class="small text-muted mb-0">@Model.DestinationStation?.Address, @Model.DestinationStation?.City</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pickup & Dropoff Points Column -->
        <div class="col-lg-6">
            <div class="row g-4">
                <!-- Pickup Points Card -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 bg-dark-subtle">
                        <div class="card-header bg-transparent border-bottom border-secondary py-3 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-light mb-0"><i class="fa-solid fa-circle-arrow-up text-success me-2"></i>Pickup Points</h5>
                            <span class="badge bg-success">@Model.PickupPoints.Count Points</span>
                        </div>
                        <div class="card-body p-4">
                            @if (!Model.PickupPoints.Any())
                            {
                                <p class="text-muted small mb-0 fst-italic">No pickup points added yet.</p>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var point in Model.PickupPoints.GroupBy(p => p.Station))
                                    {
                                        <div class="list-group-item bg-transparent border-0 px-0 pb-3 text-start">
                                            <h6 class="fw-bold text-light mb-2"><i class="fa-solid fa-location-dot me-2 text-muted"></i>@point.Key?.StationName</h6>
                                            <div class="d-flex flex-wrap gap-2 ps-4">
                                                @foreach (var p in point)
                                                {
                                                    <span class="badge bg-dark border border-secondary text-light rounded-pill px-3 py-2">
                                                        @p.PointName
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Drop-off Points Card -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 bg-dark-subtle">
                        <div class="card-header bg-transparent border-bottom border-secondary py-3 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-light mb-0"><i class="fa-solid fa-circle-arrow-down text-info me-2"></i>Drop-Off Points</h5>
                            <span class="badge bg-info text-dark">@Model.DropOffPoints.Count Points</span>
                        </div>
                        <div class="card-body p-4">
                            @if (!Model.DropOffPoints.Any())
                            {
                                <p class="text-muted small mb-0 fst-italic">No drop-off points added yet.</p>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var point in Model.DropOffPoints.GroupBy(p => p.Station))
                                    {
                                        <div class="list-group-item bg-transparent border-0 px-0 pb-3 text-start">
                                            <h6 class="fw-bold text-light mb-2"><i class="fa-solid fa-location-dot me-2 text-muted"></i>@point.Key?.StationName</h6>
                                            <div class="d-flex flex-wrap gap-2 ps-4">
                                                @foreach (var p in point)
                                                {
                                                    <span class="badge bg-dark border border-secondary text-light rounded-pill px-3 py-2">
                                                        @p.PointName
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline-item {
        position: relative;
    }
    .timeline-marker {
        position: relative;
        flex-shrink: 0;
    }
    .timeline-line {
        position: absolute;
        top: 40px;
        left: 50%;
        transform: translateX(-50%);
        bottom: 0;
        z-index: 1;
    }
    .timeline-content {
        padding-top: 8px;
    }
</style>
