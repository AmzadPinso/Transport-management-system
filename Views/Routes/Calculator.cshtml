@{
    ViewData["Title"] = "Route Distance Calculator";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<style>
    #map {
        height: 600px;
        width: 100%;
        border-radius: 0.5rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        z-index: 1;
    }
    
    .search-panel {
        background: white;
        padding: 1.5rem;
        border-radius: 0.5rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    
    .map-controls {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 1000;
        background: white;
        padding: 10px;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }
    
    .result-card {
        display: none;
        background: linear-gradient(135deg, #4f46e5, #0ea5e9);
        color: white;
        padding: 1.5rem;
        border-radius: 0.5rem;
        margin-top: 1rem;
        box-shadow: 0 4px 15px rgba(14, 165, 233, 0.3);
    }
    
    .stat-value {
        font-size: 2rem;
        font-weight: bold;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="fa-solid fa-map-location-dot me-2 text-primary"></i>Route Distance Calculator</h2>
            <p class="text-muted mb-0">Select start and destination points to calculate driving distance and time.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-3">
                <i class="fa-solid fa-arrow-left me-2"></i>Back to Routes
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Controls -->
        <div class="col-lg-4">
            <div class="search-panel mb-4">
                <h5 class="fw-bold mb-3">Location Selection</h5>
                
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Origin (Start Point)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-success text-white"><i class="fa-solid fa-location-dot"></i></span>
                        <input type="text" id="originSearch" class="form-control" placeholder="Search city, address..." />
                        <button class="btn btn-success" type="button" onclick="searchLocation('origin')">Search</button>
                    </div>
                    <div class="mt-2 text-center text-muted small">OR</div>
                    <select id="originStation" class="form-select mt-2" asp-items="ViewBag.Stations">
                        <option value="">-- Select Existing Station --</option>
                    </select>
                </div>
                
                <div class="text-center my-2">
                    <button class="btn btn-sm btn-outline-secondary rounded-circle" onclick="swapLocations()" title="Swap Origin and Destination">
                        <i class="fa-solid fa-arrow-right-arrow-left fa-rotate-90"></i>
                    </button>
                </div>
                
                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">Destination (End Point)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-danger text-white"><i class="fa-solid fa-location-dot"></i></span>
                        <input type="text" id="destSearch" class="form-control" placeholder="Search city, address..." />
                        <button class="btn btn-danger" type="button" onclick="searchLocation('dest')">Search</button>
                    </div>
                    <div class="mt-2 text-center text-muted small">OR</div>
                    <select id="destStation" class="form-select mt-2" asp-items="ViewBag.Stations">
                        <option value="">-- Select Existing Station --</option>
                    </select>
                </div>
                
                <div class="d-grid gap-2">
                    <button class="btn btn-primary fw-bold py-2" onclick="calculateRoute()">
                        <i class="fa-solid fa-calculator me-2"></i>Calculate Route
                    </button>
                    <button class="btn btn-light" onclick="resetMap()">
                        <i class="fa-solid fa-rotate-left me-2"></i>Reset
                    </button>
                </div>
                <div class="mt-3 text-muted small text-center" id="mapInstruction">
                    <i class="fa-solid fa-circle-info me-1"></i>You can also click on the map to set points.
                </div>
            </div>
            
            <!-- Result Card -->
            <div id="resultCard" class="result-card">
                <h5 class="fw-bold mb-4 opacity-75 text-uppercase border-bottom border-light pb-2">Route Summary</h5>
                <div class="row">
                    <div class="col-6">
                        <div class="small opacity-75">Distance</div>
                        <div class="stat-value" id="resDistance">--</div>
                        <div class="small">Kilometers</div>
                    </div>
                    <div class="col-6">
                        <div class="small opacity-75">Estimated Time</div>
                        <div class="stat-value" id="resTime">--</div>
                        <div class="small">Hours / Mins</div>
                    </div>
                </div>
                
                <div id="importContainer" class="mt-4 text-center" style="display: none;">
                    <button class="btn btn-light text-primary fw-bold w-100" onclick="importToForm()">
                        <i class="fa-solid fa-file-import me-2"></i>Use in Route Form
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Map Area -->
        <div class="col-lg-8">
            <div class="position-relative">
                <div id="map"></div>
                <div class="map-controls small">
                    <div id="coordsDisplay">Coords: --</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        let map, originMarker, destMarker, routeLayer;
        let originLatLng = null;
        let destLatLng = null;
        
        // Define custom icons
        const originIcon = L.icon({
            iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png',
            shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
            iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
        });
        
        const destIcon = L.icon({
            iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',
            shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
            iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
        });

        // Initialize Map
        document.addEventListener('DOMContentLoaded', function() {
            // Default center: Dhaka, Bangladesh
            map = L.map('map').setView([23.8103, 90.4125], 7);
            
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);
            
            // Map click event
            map.on('click', function(e) {
                if (!originLatLng) {
                    setOrigin(e.latlng);
                } else if (!destLatLng) {
                    setDest(e.latlng);
                    calculateRoute();
                } else {
                    // Reset and start over
                    resetMap();
                    setOrigin(e.latlng);
                }
            });
            
            map.on('mousemove', function(e) {
                document.getElementById('coordsDisplay').innerText = `Lat: ${e.latlng.lat.toFixed(4)}, Lng: ${e.latlng.lng.toFixed(4)}`;
            });

            // Check if opened as popup/modal
            if (window.opener && !window.opener.closed) {
                document.getElementById('importContainer').style.display = 'block';
            }
        });

        function setOrigin(latlng, title = "Start Point") {
            originLatLng = latlng;
            if (originMarker) map.removeLayer(originMarker);
            originMarker = L.marker(latlng, {icon: originIcon}).addTo(map).bindPopup(title).openPopup();
            document.getElementById('mapInstruction').innerHTML = "<i class='fa-solid fa-circle-info me-1'></i>Now click on the map to set Destination.";
        }

        function setDest(latlng, title = "End Point") {
            destLatLng = latlng;
            if (destMarker) map.removeLayer(destMarker);
            destMarker = L.marker(latlng, {icon: destIcon}).addTo(map).bindPopup(title).openPopup();
            document.getElementById('mapInstruction').innerHTML = "<i class='fa-solid fa-circle-info me-1'></i>Locations set. Calculating route...";
        }

        // Geocoding with Nominatim
        async function searchLocation(type) {
            const query = document.getElementById(type === 'origin' ? 'originSearch' : 'destSearch').value;
            if (!query) return;
            
            try {
                const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`);
                const data = await response.json();
                
                if (data && data.length > 0) {
                    const latlng = L.latLng(data[0].lat, data[0].lon);
                    const title = data[0].display_name.split(',')[0];
                    
                    if (type === 'origin') {
                        setOrigin(latlng, title);
                        map.setView(latlng, 12);
                    } else {
                        setDest(latlng, title);
                        map.setView(latlng, 12);
                    }
                    
                    if (originLatLng && destLatLng) {
                        calculateRoute();
                    }
                } else {
                    alert('Location not found.');
                }
            } catch (error) {
                console.error('Error fetching location:', error);
                alert('Error searching location.');
            }
        }
        
        // Handle station selection (for future geo-integration if stations have lat/lng)
        // Since stations might not have lat/lng in DB right now, we fallback to searching their name
        document.getElementById('originStation').addEventListener('change', function() {
            if(this.options[this.selectedIndex].text !== "-- Select Existing Station --") {
                document.getElementById('originSearch').value = this.options[this.selectedIndex].text + ", Bangladesh";
                searchLocation('origin');
            }
        });

        document.getElementById('destStation').addEventListener('change', function() {
            if(this.options[this.selectedIndex].text !== "-- Select Existing Station --") {
                document.getElementById('destSearch').value = this.options[this.selectedIndex].text + ", Bangladesh";
                searchLocation('dest');
            }
        });

        function swapLocations() {
            const tempLat = originLatLng;
            const tempSearch = document.getElementById('originSearch').value;
            
            originLatLng = destLatLng;
            document.getElementById('originSearch').value = document.getElementById('destSearch').value;
            
            destLatLng = tempLat;
            document.getElementById('destSearch').value = tempSearch;
            
            if (originLatLng) setOrigin(originLatLng);
            if (destLatLng) setDest(destLatLng);
            
            if (originLatLng && destLatLng) calculateRoute();
        }

        function resetMap() {
            originLatLng = null;
            destLatLng = null;
            if (originMarker) map.removeLayer(originMarker);
            if (destMarker) map.removeLayer(destMarker);
            if (routeLayer) map.removeLayer(routeLayer);
            document.getElementById('originSearch').value = '';
            document.getElementById('destSearch').value = '';
            document.getElementById('originStation').selectedIndex = 0;
            document.getElementById('destStation').selectedIndex = 0;
            document.getElementById('resultCard').style.display = 'none';
            document.getElementById('mapInstruction').innerHTML = "<i class='fa-solid fa-circle-info me-1'></i>Click on the map to set Origin.";
        }

        async function calculateRoute() {
            if (!originLatLng || !destLatLng) {
                alert("Please select both Origin and Destination.");
                return;
            }
            
            try {
                // Using OSRM public API for driving route
                const url = `https://router.project-osrm.org/route/v1/driving/${originLatLng.lng},${originLatLng.lat};${destLatLng.lng},${destLatLng.lat}?overview=full&geometries=geojson`;
                const response = await fetch(url);
                const data = await response.json();
                
                if (data.code === 'Ok' && data.routes.length > 0) {
                    const route = data.routes[0];
                    const distanceKm = (route.distance / 1000).toFixed(1);
                    const durationMins = Math.round(route.duration / 60);
                    
                    const hours = Math.floor(durationMins / 60);
                    const mins = durationMins % 60;
                    const timeStr = hours > 0 ? `${hours}h ${mins}m` : `${mins}m`;
                    
                    // Display results
                    document.getElementById('resDistance').innerText = distanceKm;
                    document.getElementById('resTime').innerText = timeStr;
                    document.getElementById('resultCard').style.display = 'block';
                    
                    // Store plain values for import
                    document.getElementById('resultCard').dataset.distance = distanceKm;
                    document.getElementById('resultCard').dataset.duration = durationMins;
                    
                    // Draw route
                    if (routeLayer) map.removeLayer(routeLayer);
                    routeLayer = L.geoJSON(route.geometry, {
                        style: {
                            color: '#4f46e5',
                            weight: 5,
                            opacity: 0.8
                        }
                    }).addTo(map);
                    
                    // Fit bounds
                    map.fitBounds(routeLayer.getBounds(), { padding: [50, 50] });
                } else {
                    alert("No route found between these locations.");
                }
            } catch (error) {
                console.error("Routing error:", error);
                alert("An error occurred while calculating the route.");
            }
        }
        
        function importToForm() {
            if (window.opener && !window.opener.closed) {
                const distance = document.getElementById('resultCard').dataset.distance;
                const duration = document.getElementById('resultCard').dataset.duration;
                
                // Assuming standard IDs in the Create/Edit Route forms
                const distField = window.opener.document.getElementById('DistanceKm');
                const durField = window.opener.document.getElementById('EstimatedDurationMinutes');
                
                if (distField) distField.value = distance;
                if (durField) durField.value = duration;
                
                window.close();
            }
        }
    </script>
}
