@model IEnumerable<Transport_Management_System.Models.Route>
@using Transport_Management_System.Models

@{
    ViewData["Title"] = "Route Management";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Route Management</h1>
            <p class="text-muted small mb-0">Define transit lines, intermediate stops, and pickup/drop-off points.</p>
        </div>
        <a asp-action="Create" class="btn-modern btn-modern-primary shadow-sm text-decoration-none">
            <i class="fa-solid fa-plus me-2"></i><span>Define Route</span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-lg-3 col-md-6">
                    <label class="form-label text-muted small fw-bold mb-1">Search Route</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0 text-muted">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" name="search" value="@ViewBag.Search" 
                               class="form-control bg-light border-0 ps-0" 
                               placeholder="Name or Station..." />
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label text-muted small fw-bold mb-1">Origin Station</label>
                    <select name="originStationId" class="form-select bg-light border-0" asp-items="ViewBag.Stations">
                        <option value="">All Stations</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label text-muted small fw-bold mb-1">Destination Station</label>
                    <select name="destinationStationId" class="form-select bg-light border-0" asp-items="ViewBag.Stations">
                        <option value="">All Stations</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label text-muted small fw-bold mb-1">Route Status</label>
                    <select name="status" class="form-select bg-light border-0" asp-items="Html.GetEnumSelectList<RouteStatus>()">
                        <option value="">All Statuses</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-8">
                    <label class="form-label text-muted small fw-bold mb-1">City Filter</label>
                    <input type="text" name="city" value="@ViewBag.City" class="form-control bg-light border-0" placeholder="e.g. Dhaka" />
                </div>
                <div class="col-lg-1 col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100 rounded-3 py-2">
                        <i class="fa-solid fa-filter"></i>
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.Search) || ViewBag.OriginStationId != null || ViewBag.DestinationStationId != null || ViewBag.Status != null || !string.IsNullOrEmpty(ViewBag.City))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary ms-2 px-3 rounded-3 py-2" title="Clear Filters">
                            <i class="fa-solid fa-xmark"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Table Section -->
    <div class="table-container animate-fade-in-up">
        <table class="table table-modern align-middle mb-0">
            <thead>
                <tr>
                    <th>
                        <a class="text-decoration-none text-muted" asp-action="Index" asp-route-sortColumn="name" asp-route-sortDirection="@(ViewBag.SortColumn == "name" && ViewBag.SortDirection == "asc" ? "desc" : "asc")">
                            Route Name @(ViewBag.SortColumn == "name" ? (ViewBag.SortDirection == "asc" ? "↑" : "↓") : "")
                        </a>
                    </th>
                    <th>
                        <a class="text-decoration-none text-muted" asp-action="Index" asp-route-sortColumn="origin" asp-route-sortDirection="@(ViewBag.SortColumn == "origin" && ViewBag.SortDirection == "asc" ? "desc" : "asc")">
                            Origin Station @(ViewBag.SortColumn == "origin" ? (ViewBag.SortDirection == "asc" ? "↑" : "↓") : "")
                        </a>
                    </th>
                    <th>
                        <a class="text-decoration-none text-muted" asp-action="Index" asp-route-sortColumn="destination" asp-route-sortDirection="@(ViewBag.SortColumn == "destination" && ViewBag.SortDirection == "asc" ? "desc" : "asc")">
                            Destination Station @(ViewBag.SortColumn == "destination" ? (ViewBag.SortDirection == "asc" ? "↑" : "↓") : "")
                        </a>
                    </th>
                    <th>
                        <a class="text-decoration-none text-muted" asp-action="Index" asp-route-sortColumn="distance" asp-route-sortDirection="@(ViewBag.SortColumn == "distance" && ViewBag.SortDirection == "asc" ? "desc" : "asc")">
                            Distance (km) @(ViewBag.SortColumn == "distance" ? (ViewBag.SortDirection == "asc" ? "↑" : "↓") : "")
                        </a>
                    </th>
                    <th>
                        <a class="text-decoration-none text-muted" asp-action="Index" asp-route-sortColumn="duration" asp-route-sortDirection="@(ViewBag.SortColumn == "duration" && ViewBag.SortDirection == "asc" ? "desc" : "asc")">
                            Duration @(ViewBag.SortColumn == "duration" ? (ViewBag.SortDirection == "asc" ? "↑" : "↓") : "")
                        </a>
                    </th>
                    <th>
                        <a class="text-decoration-none text-muted" asp-action="Index" asp-route-sortColumn="status" asp-route-sortDirection="@(ViewBag.SortColumn == "status" && ViewBag.SortDirection == "asc" ? "desc" : "asc")">
                            Status @(ViewBag.SortColumn == "status" ? (ViewBag.SortDirection == "asc" ? "↑" : "↓") : "")
                        </a>
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-route d-block fs-1 mb-3 opacity-25"></i>
                            <p class="mb-0">No routes found matching your criteria.</p>
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    var statusBadgeClass = item.Status switch
                    {
                        RouteStatus.Active => "bg-success-subtle text-success",
                        RouteStatus.Inactive => "bg-danger-subtle text-danger",
                        RouteStatus.UnderMaintenance => "bg-warning-subtle text-warning",
                        _ => "bg-secondary-subtle text-secondary"
                    };

                    int hrs = item.EstimatedDurationMinutes / 60;
                    int mins = item.EstimatedDurationMinutes % 60;
                    string durationStr = hrs > 0 ? $"{hrs}h {mins}m" : $"{mins}m";

                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="user-avatar" style="width: 32px; height: 32px; font-size: 0.8rem; background-color: var(--bs-primary-bg-subtle); color: var(--bs-primary);">
                                    <i class="fa-solid fa-route"></i>
                                </div>
                                <div class="fw-bold text-dark">@item.RouteName</div>
                            </div>
                        </td>
                        <td><span class="text-dark">@(item.OriginStation?.StationName ?? "N/A")</span></td>
                        <td><span class="text-dark">@(item.DestinationStation?.StationName ?? "N/A")</span></td>
                        <td><span class="text-dark fw-bold">@item.DistanceKm km</span></td>
                        <td><span class="text-muted small">@durationStr</span></td>
                        <td>
                            <span class="badge rounded-pill @statusBadgeClass px-3 py-2 border-0">
                                @item.Status
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="ManageStops" asp-route-id="@item.RouteId" class="btn btn-sm btn-outline-warning border-0 rounded-pill px-3 py-2" title="Manage Intermediate Stops">
                                    <i class="fa-solid fa-list-ol me-1"></i>Stops
                                </a>
                                <a asp-action="ManagePoints" asp-route-id="@item.RouteId" class="btn btn-sm btn-outline-info border-0 rounded-pill px-3 py-2" title="Manage Pickup/Dropoff Points">
                                    <i class="fa-solid fa-location-crosshairs me-1"></i>Points
                                </a>
                                <a asp-action="Details" asp-route-id="@item.RouteId" class="btn btn-sm btn-outline-light border-0 rounded-circle p-2" title="View Details">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.RouteId" class="btn btn-sm btn-outline-primary border-0 rounded-circle p-2" title="Edit">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteRouteModal-@item.RouteId">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </div>

                            <!-- Delete Modal -->
                            <div class="modal fade" id="deleteRouteModal-@item.RouteId" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content bg-dark border-secondary rounded-4">
                                        <div class="modal-header border-bottom border-secondary">
                                            <h5 class="modal-title text-light fw-bold"><i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>Confirm Delete</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body text-start text-muted py-4">
                                            Are you sure you want to delete the route <strong class="text-light">@item.RouteName</strong>? All intermediate stops and points will be deleted.
                                        </div>
                                        <div class="modal-footer border-top border-secondary">
                                            <button type="button" class="btn btn-outline-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                                            <form asp-action="Delete" asp-route-id="@item.RouteId" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-danger rounded-3 px-4">Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
            
    <!-- Modern Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination pagination-modern gap-2">
                    <li class="page-item @(ViewBag.PageNumber == 1 ? "disabled" : "")">
                        <a class="page-link border-0 rounded-circle shadow-sm" asp-action="Index" 
                           asp-route-pageNumber="@(ViewBag.PageNumber - 1)" 
                           asp-route-pageSize="@ViewBag.PageSize"
                           asp-route-search="@ViewBag.Search"
                           asp-route-originStationId="@ViewBag.OriginStationId"
                           asp-route-destinationStationId="@ViewBag.DestinationStationId"
                           asp-route-status="@ViewBag.Status"
                           asp-route-city="@ViewBag.City"
                           asp-route-sortColumn="@ViewBag.SortColumn"
                           asp-route-sortDirection="@ViewBag.SortDirection">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    </li>
                    
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item">
                            <a class="page-link border-0 shadow-sm rounded-circle @(i == ViewBag.PageNumber ? "bg-primary text-white" : "bg-white text-dark")" asp-action="Index" 
                               asp-route-pageNumber="@i" 
                               asp-route-pageSize="@ViewBag.PageSize"
                               asp-route-search="@ViewBag.Search"
                               asp-route-originStationId="@ViewBag.OriginStationId"
                               asp-route-destinationStationId="@ViewBag.DestinationStationId"
                               asp-route-status="@ViewBag.Status"
                               asp-route-city="@ViewBag.City"
                               asp-route-sortColumn="@ViewBag.SortColumn"
                               asp-route-sortDirection="@ViewBag.SortDirection">@i</a>
                        </li>
                    }

                    <li class="page-item @(ViewBag.PageNumber == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link border-0 rounded-circle shadow-sm" asp-action="Index" 
                           asp-route-pageNumber="@(ViewBag.PageNumber + 1)" 
                           asp-route-pageSize="@ViewBag.PageSize"
                           asp-route-search="@ViewBag.Search"
                           asp-route-originStationId="@ViewBag.OriginStationId"
                           asp-route-destinationStationId="@ViewBag.DestinationStationId"
                           asp-route-status="@ViewBag.Status"
                           asp-route-city="@ViewBag.City"
                           asp-route-sortColumn="@ViewBag.SortColumn"
                           asp-route-sortDirection="@ViewBag.SortDirection">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
