@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center animate-fade-in-up">
        <div class="col-md-6 text-center">
            <div class="card-modern shadow-premium p-5">
                <div class="display-1 text-danger mb-4">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h1 class="fw-bold mb-3">Access Denied</h1>
                <p class="text-muted mb-5 fs-5">
                    You do not have the required permissions to view this resource. 
                    If you believe this is a mistake, please reach out to your system administrator.
                </p>
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn-modern btn-modern-primary px-5">
                        <i class="fa-solid fa-house"></i> Return Home
                    </a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger px-5" style="border-radius: var(--radius); font-weight: 600;">
                            <i class="fa-solid fa-right-from-bracket me-2"></i>Logout
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
